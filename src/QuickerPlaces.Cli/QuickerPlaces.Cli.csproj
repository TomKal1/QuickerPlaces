    <Compile Include="..\QuickerPlaces\Services\PlacesService.cs" Link="Linked\Services\PlacesService.cs" />
    <Compile Include="..\QuickerPlaces\Services\PlacesStoreMigration.cs" Link="Linked\Services\PlacesStoreMigration.cs" />
    <Compile Include="..\QuickerPlaces\Services\RecentlyDeletedPolicy.cs" Link="Linked\Services\RecentlyDeletedPolicy.cs" />
    <Compile Include="..\QuickerPlaces\Services\ValidationResult.cs" Link="Linked\Services\ValidationResult.cs" />
    <Compile Include="..\QuickerPlaces\Models\Activity\*.cs" LinkBase="Linked\Models\Activity" />
    <Compile Include="..\QuickerPlaces\Services\Activity\ActivityDayTotal.cs" Link="Linked\Services\Activity\ActivityDayTotal.cs" />
