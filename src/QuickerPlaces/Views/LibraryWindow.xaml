<Window x:Class="QuickerPlaces.Views.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Library"
        Width="1100" Height="780" MinWidth="820" MinHeight="600"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!--
        Documents plan §6. Everything QuickerPlaces knows about, together:
        saved places, files in saved sessions, folders from Recents and files
        from Recent Files. Split by kind with the chips, by saved or recent,
        grouped by type or by tag; the year strip shows when things were used
        and a day on it lists what was used that day. Recent Files' own
        settings are in the panel at the bottom. A thin view over
        LibraryViewModel; the code-behind only passes clicks in.

        Button.CalendarDay is a copy of ActivityWindow's, kept local so this
        window can be restyled or dropped without touching that one.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <CollectionViewSource x:Key="GroupedRows" Source="{Binding Rows}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupName" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="CollapsedWhenEmpty" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A kind chip: a pill, filled while it is the chosen kind. -->
        <Style x:Key="Button.KindChip" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
            <Setter Property="Background" Value="{StaticResource Bg.Elevated}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border.Strong}" />
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="13">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent.Soft}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                    <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Button.CalendarDay" TargetType="Button">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource Border.Strong}" />
            <Setter Property="Background" Value="{StaticResource Bg.Elevated}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2" />
                            <Border x:Name="TodayOutline"
                                    BorderBrush="{StaticResource Status.Info}"
                                    BorderThickness="1" CornerRadius="2"
                                    Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="TodayOutline" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Intensity}" Value="-1">
                    <Setter Property="Background" Value="{StaticResource Text.Faint}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Intensity}" Value="1">
                    <Setter Property="Background" Value="#FF30265A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Intensity}" Value="2">
                    <Setter Property="Background" Value="#FF514091" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Intensity}" Value="3">
                    <Setter Property="Background" Value="#FF7357CE" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Intensity}" Value="4">
                    <Setter Property="Background" Value="{StaticResource Accent.Hover}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Text.Primary}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInRange}" Value="False">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Library" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Your saved places and sessions, with the folders and files you've used recently, in one list."
                       Foreground="{StaticResource Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Year strip: when things were used. A day lists only what was used on it. -->
        <Border Grid.Row="1" Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Border.Default}"
                BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Border Background="{StaticResource Accent.Soft}" CornerRadius="10" Padding="10,2" Margin="0,0,10,0"
                                Visibility="{Binding HasSelectedDay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedDayText}" VerticalAlignment="Center" />
                                <Button Content="&#xE711;" FontFamily="{StaticResource Font.Icons}" FontSize="9" Padding="6,2"
                                        Margin="8,0,0,0" ToolTip="Show everything again" AutomationProperties.Name="Clear the day"
                                        Click="ClearDay_Click" />
                            </StackPanel>
                        </Border>
                        <Button Content="&#xE76B;" FontFamily="{StaticResource Font.Icons}" FontSize="10" Padding="8,3"
                                ToolTip="Previous year" AutomationProperties.Name="Previous year" Click="PreviousYear_Click" />
                        <TextBlock Text="{Binding CalendarYearLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
                        <Button Content="&#xE76C;" FontFamily="{StaticResource Font.Icons}" FontSize="10" Padding="8,3"
                                ToolTip="Next year" AutomationProperties.Name="Next year" Click="NextYear_Click" />
                    </StackPanel>
                    <TextBlock Text="{Binding CalendarCaption}" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel Grid.Row="1" HorizontalAlignment="Center">
                    <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding CalendarWeekdayLabels}" Margin="0,19,7,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Height="14" FontSize="9" Foreground="{StaticResource Text.Secondary}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ScrollViewer Height="140" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Grid Width="{Binding CalendarStripWidth}" Height="117">
                            <ItemsControl ItemsSource="{Binding CalendarWeeks}" Margin="0,19,0,0" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Days}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource Button.CalendarDay}" ToolTip="{Binding Label}"
                                                            AutomationProperties.Name="{Binding Label}" Click="CalendarDay_Click" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding CalendarMonthMarkers}" IsHitTestVisible="False" Focusable="False"
                                          Width="{Binding CalendarStripWidth}" Height="117">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas Width="{Binding DataContext.CalendarStripWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Height="117">
                                            <Polyline Points="{Binding Points}" Stroke="{StaticResource Border.Strong}" StrokeThickness="1" />
                                            <TextBlock Text="{Binding Label}" Canvas.Left="{Binding LabelX}" FontSize="10"
                                                       Foreground="{StaticResource Text.Secondary}" />
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Filters: kind chips, saved or recent, grouping, search. -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <ItemsControl ItemsSource="{Binding KindFilters}" AutomationProperties.Name="Show kind">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Button.KindChip}" Content="{Binding Label}" Click="KindChip_Click"
                                    AutomationProperties.Name="{Binding Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="Show" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <RadioButton Content="All" GroupName="Source" IsChecked="{Binding IsSourceAll}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <RadioButton Content="Saved" GroupName="Source" IsChecked="{Binding IsSourceSaved}" Margin="0,0,12,0" VerticalAlignment="Center"
                                 ToolTip="Saved places, and files in saved sessions" />
                    <RadioButton Content="Recent" GroupName="Source" IsChecked="{Binding IsSourceRecent}" Margin="0,0,28,0" VerticalAlignment="Center"
                                 ToolTip="Folders from Recents, and files from Recent Files" />
                    <TextBlock Text="Group by" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <RadioButton Content="Type" GroupName="Grouping" IsChecked="{Binding IsGroupedByType}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <RadioButton Content="Tag" GroupName="Grouping" IsChecked="{Binding IsGroupedByTag}" VerticalAlignment="Center"
                                 ToolTip="One group per session tag; untagged items last" />
                </StackPanel>
            </StackPanel>
            <Grid Grid.Column="1" Width="280" VerticalAlignment="Top">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search the Library" ToolTip="Search by name, path, tag or session"
                         PreviewKeyDown="SearchBox_PreviewKeyDown" />
                <TextBlock Text="Search" IsHitTestVisible="False" Margin="9,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource Text.Faint}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <Grid Grid.Row="3">
            <DataGrid x:Name="RowsGrid" ItemsSource="{Binding Source={StaticResource GroupedRows}}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      AutomationProperties.Name="Library items" KeyboardNavigation.TabNavigation="Once"
                      MouseDoubleClick="RowsGrid_MouseDoubleClick" PreviewKeyDown="RowsGrid_PreviewKeyDown"
                      ContextMenuOpening="RowsGrid_ContextMenuOpening">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,10,0,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}" Foreground="{StaticResource Text.Secondary}" />
                                </StackPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" Click="OpenMenu_Click" />
                        <MenuItem Header="Copy path or link" Click="CopyMenu_Click" />
                        <Separator />
                        <MenuItem x:Name="ForgetMenuItem" Header="Remove from Recent Files" Click="ForgetMenu_Click" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource TextBlock.Glyph}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Location}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Type" Binding="{Binding KindLabel}" Width="64" />
                    <DataGridTextColumn Header="Where from" Binding="{Binding SourceText}" Width="2*" />
                    <DataGridTextColumn Header="Tags" Binding="{Binding TagsText}" Width="*" />
                    <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="2*" />
                    <DataGridTextColumn Header="Last used" Binding="{Binding LastUsedText}" Width="130" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="{Binding EmptyText}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="16" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Text.Faint}" FontStyle="Italic"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <!-- Recent Files: its own switch, as Recents has for folders. -->
        <Expander Grid.Row="4" Margin="0,12,0,0" Foreground="{StaticResource Text.Primary}">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Recent Files" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding RecentFilesStatus}" Foreground="{StaticResource Text.Secondary}" Margin="12,0,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="820" />
                </StackPanel>
            </Expander.Header>
            <Border Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Border.Default}" BorderThickness="1"
                    CornerRadius="10" Padding="14,10" Margin="0,8,0,0" IsEnabled="{Binding RecentFilesAvailable}">
                <StackPanel>
                    <CheckBox Content="Record the PDF, Word and Excel files I open" IsChecked="{Binding RecentFilesEnabled}" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text.Secondary}" Margin="22,4,0,8"
                               Text="Read once a minute from Windows' own Recent Items while QuickerPlaces is running, from the moment you turn this on. It records which file and when — never what's in it — and keeps a year on this computer only. Programs that don't tell Windows about the files they open won't show here." />
                    <StackPanel Orientation="Horizontal" Margin="22,0,0,6">
                        <TextBlock Text="Kinds" Foreground="{StaticResource Text.Secondary}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <CheckBox Content="PDF" IsChecked="{Binding TrackPdf}" Margin="0,0,14,0" />
                        <CheckBox Content="Word" IsChecked="{Binding TrackWord}" Margin="0,0,14,0" />
                        <CheckBox Content="Excel" IsChecked="{Binding TrackExcel}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="22,0,0,8">
                        <TextBlock Text="Where" Foreground="{StaticResource Text.Secondary}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <RadioButton Content="Only under folders tracked in Recents" GroupName="Scope" Margin="0,0,14,0"
                                     IsChecked="{Binding TrackUnderTrackedFolders}" />
                        <RadioButton Content="Anywhere" GroupName="Scope" IsChecked="{Binding TrackEverywhere}" />
                    </StackPanel>
                    <Button Content="Delete Recent Files history…" HorizontalAlignment="Left" Margin="22,0,0,0" Click="ClearRecentFiles_Click"
                            ToolTip="Delete everything Recent Files has recorded. Your places, sessions and files are not touched." />
                </StackPanel>
            </Border>
        </Expander>

        <StackPanel Grid.Row="5" Margin="0,10,0,0">
            <TextBlock Text="{Binding RecentFilesNotice}" Foreground="{StaticResource Status.Warning}" TextWrapping="Wrap"
                       Style="{StaticResource CollapsedWhenEmpty}" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Status.Success}" TextWrapping="Wrap"
                       Style="{StaticResource CollapsedWhenEmpty}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Status.Error}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Style="{StaticResource CollapsedWhenEmpty}" />
        </StackPanel>

        <Button Grid.Row="6" Content="Close" MinWidth="84" HorizontalAlignment="Right" Margin="0,12,0,0" IsCancel="True" />
    </Grid>
</Window>
