<Window x:Class="QuickerPlaces.Views.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Library"
        Width="1100" Height="780" MinWidth="820" MinHeight="600"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!--
        Documents plan §6. Everything QuickerPlaces knows about, together:
        saved places, files in saved sessions, folders from Recents and files
        from Recent Files. Split by kind with the chips, by saved or recent,
        grouped by type or by tag; the year strip shows when things were used
        and a day on it lists what was used that day. Recent Files' own
        settings are in the panel at the bottom. A thin view over
        LibraryViewModel; the code-behind only passes clicks in.

        Button.CalendarDay and its focus ring are copies of ActivityWindow's,
        kept local so this window can be restyled or dropped without touching
        that one.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <CollectionViewSource x:Key="GroupedRows" Source="{Binding Rows}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupName" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="CollapsedWhenEmpty" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A kind chip: Recents' tracked-folder pill (ListBoxItem.Chip), filled while it is the chosen kind. -->
        <Style x:Key="Button.KindChip" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource {x:Static SystemParameters.FocusVisualStyleKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="Background" Value="{DynamicResource Bg.Raised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="15">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Highlight.Text}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Highlight.Soft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Highlight.Text}" />
                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A row's kind: folder, globe or document, in the table-row icon colours. -->
        <Style x:Key="Icon.LibraryKind" TargetType="Path" BasedOn="{StaticResource Icon.Row}">
            <Setter Property="Data" Value="{StaticResource Icon.Document}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Folder">
                    <Setter Property="Data" Value="{StaticResource Icon.Folder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Link">
                    <Setter Property="Data" Value="{StaticResource Icon.Globe}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FocusVisual.CalendarDay">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-2" CornerRadius="3" BorderThickness="1.5"
                                BorderBrush="{DynamicResource Signal}" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 12 px cells at a 14 px pitch, which ActivityCalendar assumes. Leather heat: Heat.0 (none) to Heat.4 (most). -->
        <Style x:Key="Button.CalendarDay" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.CalendarDay}" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="Background" Value="{DynamicResource Heat.0}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" />
                            <Border x:Name="TodayOutline" Margin="-1" BorderBrush="{DynamicResource Signal}"
                                    BorderThickness="1.5" CornerRadius="3" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="TodayOutline" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Intensity}" Value="-1">
                    <Setter Property="Background" Value="{DynamicResource Heat.Untracked}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Intensity}" Value="1">
                    <Setter Property="Background" Value="{DynamicResource Heat.1}" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Intensity}" Value="2">
                    <Setter Property="Background" Value="{DynamicResource Heat.2}" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Intensity}" Value="3">
                    <Setter Property="Background" Value="{DynamicResource Heat.3}" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Intensity}" Value="4">
                    <Setter Property="Background" Value="{DynamicResource Heat.4}" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Highlight.Text}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInRange}" Value="False">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Library" Style="{StaticResource TextBlock.WindowTitle}" />
            <TextBlock Text="Your saved places and sessions, with the folders and files you've used recently, in one list."
                       Foreground="{DynamicResource Text.Secondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
            <Control Style="{StaticResource TrimBand}" Margin="-20,14,-20,0" />
        </StackPanel>

        <!-- Year strip: when things were used. A day lists only what was used on it. -->
        <Border Grid.Row="1" Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,5">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Border Background="{DynamicResource Highlight.Soft}" CornerRadius="14" Height="28" Padding="12,0,3,0" Margin="0,0,10,0"
                                Visibility="{Binding HasPeriod, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding PeriodText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Style="{StaticResource Button.IconOnlyCompact}" Width="22" Height="22" Margin="6,0,0,0"
                                        ToolTip="Show everything again" AutomationProperties.Name="Clear the day"
                                        Click="ClearDay_Click">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Close}" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource Button.IconOnlyCompact}"
                                ToolTip="Previous year" AutomationProperties.Name="Previous year" Click="PreviousYear_Click">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.ChevronLeft}" />
                        </Button>
                        <TextBlock Text="{Binding CalendarYearLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" />
                        <Button Style="{StaticResource Button.IconOnlyCompact}"
                                ToolTip="Next year" AutomationProperties.Name="Next year" Click="NextYear_Click">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.ChevronRight}" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="YEAR ACTIVITY" Style="{StaticResource TextBlock.Caps}" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding CalendarCaption}" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Grid.Row="1" HorizontalAlignment="Center">
                    <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding CalendarWeekdayLabels}" Margin="0,19,7,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Height="14" FontSize="9" Foreground="{DynamicResource Text.Secondary}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ScrollViewer Height="140" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Grid Width="{Binding CalendarStripWidth}" Height="117" VerticalAlignment="Top">
                            <ItemsControl ItemsSource="{Binding CalendarWeeks}" Margin="0,19,0,0" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Days}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource Button.CalendarDay}" ToolTip="{Binding Label}"
                                                            AutomationProperties.Name="{Binding Label}" Click="CalendarDay_Click" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding CalendarMonthMarkers}" IsHitTestVisible="False" Focusable="False"
                                          Width="{Binding CalendarStripWidth}" Height="117">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas Width="{Binding DataContext.CalendarStripWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Height="117">
                                            <Polyline Points="{Binding Points}" Stroke="{DynamicResource Border.Strong}" StrokeThickness="1" />
                                            <TextBlock Text="{Binding Label}" Canvas.Left="{Binding LabelX}" FontSize="10"
                                                       Foreground="{DynamicResource Text.Secondary}" />
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Filters: kind chips, saved or recent, grouping, search. -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <ItemsControl ItemsSource="{Binding KindFilters}" AutomationProperties.Name="Show kind">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Button.KindChip}" Content="{Binding Label}" Click="KindChip_Click"
                                    AutomationProperties.Name="{Binding Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="SHOW" Style="{StaticResource TextBlock.Caps}" Margin="0,0,10,0" />
                    <GroupBox Style="{StaticResource GroupBox.Unstyled}" AutomationProperties.Name="Show">
                        <Border Style="{StaticResource Border.SegmentGroup}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="All" GroupName="Source" IsChecked="{Binding IsSourceAll}"
                                             Style="{StaticResource RadioButton.Segment}" Tag="5,0,0,5" />
                                <RadioButton Content="Saved" GroupName="Source" IsChecked="{Binding IsSourceSaved}"
                                             Style="{StaticResource RadioButton.Segment}" Tag="0"
                                             ToolTip="Saved places, and files in saved sessions" />
                                <RadioButton Content="Recent" GroupName="Source" IsChecked="{Binding IsSourceRecent}"
                                             Style="{StaticResource RadioButton.Segment}" Tag="0,5,5,0" BorderThickness="0"
                                             ToolTip="Folders from Recents, and files from Recent Files" />
                            </StackPanel>
                        </Border>
                    </GroupBox>
                    <TextBlock Text="GROUP BY" Style="{StaticResource TextBlock.Caps}" Margin="24,0,10,0" />
                    <GroupBox Style="{StaticResource GroupBox.Unstyled}" AutomationProperties.Name="Group by">
                        <Border Style="{StaticResource Border.SegmentGroup}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Type" GroupName="Grouping" IsChecked="{Binding IsGroupedByType}"
                                             Style="{StaticResource RadioButton.Segment}" Tag="5,0,0,5" />
                                <RadioButton Content="Tag" GroupName="Grouping" IsChecked="{Binding IsGroupedByTag}"
                                             Style="{StaticResource RadioButton.Segment}" Tag="0,5,5,0" BorderThickness="0"
                                             ToolTip="One group per session tag; untagged items last" />
                            </StackPanel>
                        </Border>
                    </GroupBox>
                </StackPanel>
            </StackPanel>

            <!-- Search: the main window's search box. -->
            <Border Grid.Column="1" Width="300" Height="34" VerticalAlignment="Top" CornerRadius="6" BorderThickness="1"
                    Padding="10,0,5,0" Background="{DynamicResource Bg.Sunken}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Highlight.Text}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Search}" Stroke="{DynamicResource Text.Tertiary}" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource TextBox.Bare}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search the Library" ToolTip="Search by name, path, tag or session"
                             PreviewKeyDown="SearchBox_PreviewKeyDown" />
                    <TextBlock Grid.Column="1" Text="Search by name, path, tag or session" IsHitTestVisible="False"
                               Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Text.Tertiary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <DataGrid x:Name="RowsGrid" ItemsSource="{Binding Source={StaticResource GroupedRows}}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="False" SelectionMode="Single"
                      AutomationProperties.Name="Library items" KeyboardNavigation.TabNavigation="Once"
                      MouseDoubleClick="RowsGrid_MouseDoubleClick" PreviewKeyDown="RowsGrid_PreviewKeyDown"
                      ContextMenuOpening="RowsGrid_ContextMenuOpening">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Bg.Raised}" Padding="12,7" Margin="0,6,0,0"
                                        BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ItemCount, StringFormat='  ·  {0}'}" Foreground="{DynamicResource Text.Secondary}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" FontWeight="Bold" Click="OpenMenu_Click" />
                        <MenuItem Header="Copy path or link" Click="CopyMenu_Click" />
                        <Separator />
                        <MenuItem x:Name="ForgetMenuItem" Header="Remove from Recent Files" Click="ForgetMenu_Click" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="NAME" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Style="{StaticResource Icon.LibraryKind}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Location}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="TYPE" Binding="{Binding KindLabel}" Width="70" ElementStyle="{StaticResource Cell.Secondary}" />
                    <DataGridTextColumn Header="WHERE FROM" Binding="{Binding SourceText}" Width="2*" ElementStyle="{StaticResource Cell.Secondary}" />
                    <DataGridTextColumn Header="TAGS" Binding="{Binding TagsText}" Width="*" ElementStyle="{StaticResource Cell.Text}" />
                    <DataGridTextColumn Header="FOLDER" Binding="{Binding Folder}" Width="2*" ElementStyle="{StaticResource Cell.Path}" />
                    <DataGridTextColumn Header="LAST USED" Binding="{Binding LastUsedText}" Width="140" ElementStyle="{StaticResource Cell.Secondary}" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="{Binding EmptyText}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="16" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Text.Secondary}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <!-- Recent Files: its own switch, as Recents has for folders. -->
        <Expander Grid.Row="4" Margin="0,12,0,0" Foreground="{DynamicResource Text.Primary}">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="RECENT FILES" Style="{StaticResource TextBlock.Caps}" Foreground="{DynamicResource Text.Primary}" />
                    <TextBlock Text="{Binding RecentFilesStatus}" Foreground="{DynamicResource Text.Secondary}" Margin="12,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="820" />
                </StackPanel>
            </Expander.Header>
            <Border Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                    CornerRadius="8" Padding="14,12" Margin="0,8,0,0" IsEnabled="{Binding RecentFilesAvailable}">
                <StackPanel>
                    <CheckBox Content="Record the PDF, Word and Excel files I open" IsChecked="{Binding RecentFilesEnabled}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource TextBlock.Hint}" Margin="28,4,0,10"
                               Text="Read once a minute from Windows' own Recent Items while QuickerPlaces is running, from the moment you turn this on. It records which file and when — never what's in it — and keeps a year on this computer only. Programs that don't tell Windows about the files they open won't show here." />
                    <StackPanel Orientation="Horizontal" Margin="28,0,0,8">
                        <TextBlock Text="Kinds" Style="{StaticResource TextBlock.FieldLabel}" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <CheckBox Content="PDF" IsChecked="{Binding TrackPdf}" Margin="0,0,16,0" />
                        <CheckBox Content="Word" IsChecked="{Binding TrackWord}" Margin="0,0,16,0" />
                        <CheckBox Content="Excel" IsChecked="{Binding TrackExcel}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="28,0,0,10">
                        <TextBlock Text="Where" Style="{StaticResource TextBlock.FieldLabel}" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <GroupBox Style="{StaticResource GroupBox.Unstyled}" AutomationProperties.Name="Where">
                            <Border Style="{StaticResource Border.SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Only under folders tracked in Recents" GroupName="Scope"
                                                 Style="{StaticResource RadioButton.Segment}" Tag="5,0,0,5"
                                                 IsChecked="{Binding TrackUnderTrackedFolders}" />
                                    <RadioButton Content="Anywhere" GroupName="Scope"
                                                 Style="{StaticResource RadioButton.Segment}" Tag="0,5,5,0" BorderThickness="0"
                                                 IsChecked="{Binding TrackEverywhere}" />
                                </StackPanel>
                            </Border>
                        </GroupBox>
                    </StackPanel>
                    <Button HorizontalAlignment="Left" Margin="28,0,0,0" Style="{StaticResource Button.Compact}" Click="ClearRecentFiles_Click"
                            ToolTip="Delete everything Recent Files has recorded. Your places, sessions and files are not touched."
                            AutomationProperties.Name="Delete Recent Files history">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Trash}" />
                            <TextBlock Text="Delete Recent Files history…" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Expander>

        <StackPanel Grid.Row="5" Margin="0,10,0,0">
            <TextBlock Text="{Binding RecentFilesNotice}" Foreground="{DynamicResource Signal}" TextWrapping="Wrap"
                       Style="{StaticResource CollapsedWhenEmpty}" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Highlight.Text}" TextWrapping="Wrap"
                       Style="{StaticResource CollapsedWhenEmpty}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Style="{StaticResource CollapsedWhenEmpty}" />
        </StackPanel>

        <Button Grid.Row="6" Content="Close" MinWidth="84" HorizontalAlignment="Right" Margin="0,12,0,0" IsCancel="True" />
    </Grid>
</Window>
