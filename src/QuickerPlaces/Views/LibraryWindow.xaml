<Window x:Class="QuickerPlaces.Views.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="clr-namespace:QuickerPlaces.Views.Panels"
        Title="Library"
        Width="1100" Height="780" MinWidth="820" MinHeight="600"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!--
        Documents plan §6. Everything QuickerPlaces knows about, together:
        saved places, files in saved sessions, folders from Recents and files
        from Recent Files. Since the configurable canvas plan's M2 this window
        hosts the Year activity and File shelf panels over one
        LibraryViewModel, so the period chosen on the strip narrows the list,
        as it will in the workspace. Recent Files' own settings stay here, in
        the panel at the bottom.
    -->
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Library" Style="{StaticResource TextBlock.WindowTitle}" />
            <TextBlock Text="Your saved places and sessions, with the folders and files you've used recently, in one list."
                       Foreground="{DynamicResource Text.Secondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
            <Control Style="{StaticResource TrimBand}" Margin="-20,14,-20,0" />
        </StackPanel>

        <panels:YearActivityPanel Grid.Row="1" Margin="0,0,0,12" />

        <panels:FileShelfPanel x:Name="Shelf" Grid.Row="2" />

        <!-- Recent Files: its own switch, as Recents has for folders. -->
        <Expander Grid.Row="3" Margin="0,12,0,0" Foreground="{DynamicResource Text.Primary}">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="RECENT FILES" Style="{StaticResource TextBlock.Caps}" Foreground="{DynamicResource Text.Primary}" />
                    <TextBlock Text="{Binding RecentFilesStatus}" Foreground="{DynamicResource Text.Secondary}" Margin="12,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="820" />
                </StackPanel>
            </Expander.Header>
            <Border Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                    CornerRadius="8" Padding="14,12" Margin="0,8,0,0" IsEnabled="{Binding RecentFilesAvailable}">
                <StackPanel>
                    <CheckBox Content="Record the PDF, Word and Excel files I open" IsChecked="{Binding RecentFilesEnabled}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource TextBlock.Hint}" Margin="28,4,0,10"
                               Text="Read once a minute from Windows' own Recent Items while QuickerPlaces is running, from the moment you turn this on. It records which file and when — never what's in it — and keeps a year on this computer only. Programs that don't tell Windows about the files they open won't show here." />
                    <StackPanel Orientation="Horizontal" Margin="28,0,0,8">
                        <TextBlock Text="Kinds" Style="{StaticResource TextBlock.FieldLabel}" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <CheckBox Content="PDF" IsChecked="{Binding TrackPdf}" Margin="0,0,16,0" />
                        <CheckBox Content="Word" IsChecked="{Binding TrackWord}" Margin="0,0,16,0" />
                        <CheckBox Content="Excel" IsChecked="{Binding TrackExcel}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="28,0,0,10">
                        <TextBlock Text="Where" Style="{StaticResource TextBlock.FieldLabel}" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <GroupBox Style="{StaticResource GroupBox.Unstyled}" AutomationProperties.Name="Where">
                            <Border Style="{StaticResource Border.SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Only under folders tracked in Recents" GroupName="Scope"
                                                 Style="{StaticResource RadioButton.Segment}" Tag="5,0,0,5"
                                                 IsChecked="{Binding TrackUnderTrackedFolders}" />
                                    <RadioButton Content="Anywhere" GroupName="Scope"
                                                 Style="{StaticResource RadioButton.Segment}" Tag="0,5,5,0" BorderThickness="0"
                                                 IsChecked="{Binding TrackEverywhere}" />
                                </StackPanel>
                            </Border>
                        </GroupBox>
                    </StackPanel>
                    <Button HorizontalAlignment="Left" Margin="28,0,0,0" Style="{StaticResource Button.Compact}" Click="ClearRecentFiles_Click"
                            ToolTip="Delete everything Recent Files has recorded. Your places, sessions and files are not touched."
                            AutomationProperties.Name="Delete Recent Files history">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Trash}" />
                            <TextBlock Text="Delete Recent Files history…" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Expander>

        <TextBlock Grid.Row="4" Text="{Binding RecentFilesNotice}" Foreground="{DynamicResource Signal}" TextWrapping="Wrap"
                   Margin="0,10,0,0" Style="{StaticResource CollapsedWhenEmpty}" />

        <Button Grid.Row="5" Content="Close" MinWidth="84" HorizontalAlignment="Right" Margin="0,12,0,0" IsCancel="True" />
    </Grid>
</Window>
