<Window x:Class="QuickerPlaces.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:converters="clr-namespace:QuickerPlaces.Converters"
        mc:Ignorable="d"
        Title="{Binding AppName}"
        Height="650" Width="1000"
        MinHeight="200" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        d:DesignHeight="650" d:DesignWidth="1000">

    <Window.Resources>
        <converters:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter" />
        <converters:CollectionCountToVisibilityConverter x:Key="CollectionCountToVisibilityConverter" />
        <!--
            Used by the unsaved-changes banner (plan 5.2), the search box's
            clear button, and the status bar's Undo button: plain
            bool -> Visibility, with no "collapsed still reserves space"
            wrinkle the way BoolToGridLengthConverter's row has.
        -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!--
            Shared per-row/per-bubble context menu content. A ContextMenu is
            shown in its own Popup, not the visual/logical tree it's
            attached to, so its content can't reach the row/bubble via
            ordinary DataContext inheritance — every binding below goes
            through PlacementTarget explicitly instead (deliberately not
            relying on ContextMenu's own DataContext at all, which is a
            well-known WPF gray area): Tag on the row/bubble is bound to
            the window's MainViewModel for the Command half, and
            PlacementTarget.DataContext (the row/bubble's own PlaceViewModel)
            supplies the CommandParameter half.
        -->
        <ContextMenu x:Key="PlaceContextMenu">
            <MenuItem Header="Open"
                      Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      FontWeight="Bold" />
            <MenuItem Header="Copy Path/URL" InputGestureText="Ctrl+C"
                      Command="{Binding PlacementTarget.Tag.CopyResourceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Rename Alias"
                      Command="{Binding PlacementTarget.Tag.RenameAliasCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Edit Path/URL"
                      Command="{Binding PlacementTarget.Tag.EditResourceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Toggle Favourite"
                      Command="{Binding PlacementTarget.Tag.ToggleFavouriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <!-- No confirmation any more (roadmap §4.8): the tooltip says where it goes and how to get it back. -->
            <MenuItem Header="Remove" InputGestureText="Delete"
                      ToolTip="Moves this place to Recently Deleted. Ctrl+Z puts it back, or restore it from Recently Deleted within 7 days."
                      Command="{Binding PlacementTarget.Tag.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <!-- SI §6.4 — a bubble's own right-click menu offers removal directly, without going back to the grid. Open is included too, for convenience. -->
        <ContextMenu x:Key="BubbleContextMenu">
            <MenuItem Header="Open"
                      Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      FontWeight="Bold" />
            <MenuItem Header="Copy Path/URL"
                      Command="{Binding PlacementTarget.Tag.CopyResourceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Remove from Favourites"
                      Command="{Binding PlacementTarget.Tag.ToggleFavouriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
    </Window.Resources>

    <!--
        Window-wide keyboard shortcuts. Row-level ones (Enter, F2, Ctrl+E,
        Ctrl+D, Delete) live in PlacesGrid_PreviewKeyDown instead, so they
        only act on the grid's selected row and never fire while typing in
        the search box. Ctrl+F is ApplicationCommands.Find's built-in
        gesture, handled by the CommandBinding below.
    -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding AddFolderCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="U" Command="{Binding AddUrlCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="H" Command="{Binding ToggleGridCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoRemoveCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding OpenFavouriteAtCommand}" CommandParameter="0" />
        <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding OpenFavouriteAtCommand}" CommandParameter="1" />
        <KeyBinding Modifiers="Ctrl" Key="D3" Command="{Binding OpenFavouriteAtCommand}" CommandParameter="2" />
        <KeyBinding Modifiers="Ctrl" Key="D4" Command="{Binding OpenFavouriteAtCommand}" CommandParameter="3" />
        <KeyBinding Modifiers="Ctrl" Key="D5" Command="{Binding OpenFavouriteAtCommand}" CommandParameter="4" />
        <KeyBinding Modifiers="Ctrl" Key="D6" Command="{Binding OpenFavouriteAtCommand}" CommandParameter="5" />
        <KeyBinding Modifiers="Ctrl" Key="D7" Command="{Binding OpenFavouriteAtCommand}" CommandParameter="6" />
        <KeyBinding Modifiers="Ctrl" Key="D8" Command="{Binding OpenFavouriteAtCommand}" CommandParameter="7" />
        <KeyBinding Modifiers="Ctrl" Key="D9" Command="{Binding OpenFavouriteAtCommand}" CommandParameter="8" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="Find_Executed" />
    </Window.CommandBindings>

    <Grid x:Name="RootGrid" Margin="16">
        <Grid.RowDefinitions>
            <!-- Row 0: unsaved-changes banner (plan 5.2). Auto height, so a Collapsed banner takes no space. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!--
                RowDefinition isn't a FrameworkElement, so it doesn't inherit
                DataContext the way a normal element does — a plain
                "{Binding IsGridExpanded}" here would silently fail to find
                a source. Binding via ElementName to the root Grid sidesteps
                that (it resolves by name in the XAML namescope, then reads
                *that* element's DataContext explicitly), which is the
                standard, reliable way to data-bind a RowDefinition.
            -->
            <RowDefinition Height="{Binding DataContext.IsGridExpanded, ElementName=RootGrid, Converter={StaticResource BoolToGridLengthConverter}}" />
            <!-- Status bar ("Removed "Docs". Undo"); collapses to nothing when there's no message. -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Unsaved-changes banner (plan 5.2). Non-modal and it must never
            steal focus — Focusable="False" here is a requirement, not a
            style choice: this can appear while the user is mid-interaction
            elsewhere in the window (e.g. right after a failed save
            triggered by an edit), and a banner that yanked keyboard focus
            on appearance would interrupt whatever they were doing. Nothing
            inside it calls .Focus() either, so it never grabs focus on its
            own. Bound through BooleanToVisibilityConverter rather than a
            code-behind toggle, consistent with how the DataGrid's own
            collapsed state (the bound RowDefinition below) is driven
            entirely from the view model.
        -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="12,10" CornerRadius="10"
                Background="{StaticResource Bg.Elevated}"
                BorderBrush="{StaticResource Status.Warning}"
                BorderThickness="1"
                Focusable="False"
                Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding PersistenceMessage}"
                           Foreground="{StaticResource Status.Warning}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="Retry" Command="{Binding RetrySaveCommand}"
                            Style="{StaticResource Button.Primary}" Margin="0,0,8,0" />
                    <Button Content="Show Data Folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                    <Button Content="Show Log" Command="{Binding ShowLogCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Header: monogram glyph, app name + subheader, add/export/import action row -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="10"
                    Background="{StaticResource Accent}" VerticalAlignment="Top">
                <TextBlock Text="{Binding Monogram}" FontWeight="Bold" FontSize="14"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding AppName}" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="{Binding SubHeaderText}" FontSize="13"
                           Foreground="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Icon-only so the header still fits at the window's MinWidth. -->
                <Button Content="&#xE713;" FontFamily="{StaticResource Font.Icons}"
                        Click="SettingsButton_Click" Margin="0,0,8,0"
                        ToolTip="Settings"
                        AutomationProperties.Name="Settings" />
                <Button Content="&#xE838;" FontFamily="{StaticResource Font.Icons}"
                        Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0"
                        ToolTip="Open data folder (where places.json and any backups are kept)"
                        AutomationProperties.Name="Open data folder" />
                <!-- D20: the window has no menu, so Recently Deleted joins the other two secondary icon buttons. -->
                <Button Content="&#xE74D;" FontFamily="{StaticResource Font.Icons}"
                        Command="{Binding ShowRecentlyDeletedCommand}" Margin="0,0,8,0"
                        ToolTip="Recently Deleted — places you removed in the last 7 days"
                        AutomationProperties.Name="Recently Deleted" />
                <Button Content="Import..." Command="{Binding ImportCommand}" Margin="0,0,8,0" />
                <Button Content="Export..." Command="{Binding ExportCommand}" Margin="0,0,16,0" />
                <Button Content="Add Folder" Command="{Binding AddFolderCommand}" Margin="0,0,8,0" ToolTip="Add Folder (Ctrl+N)" />
                <Button Content="Add URL" Command="{Binding AddUrlCommand}" Style="{StaticResource Button.Primary}" ToolTip="Add URL (Ctrl+U)" />
            </StackPanel>
        </Grid>

        <!--
            Favourites (SI §6.4) — one-click bubbles above the grid. Each
            bubble is a Button styled as a pill (Button.Bubble); clicking it
            opens the place, matching a grid row's double-click. Drag to
            reorder is handled in code-behind (Bubble_PreviewMouseMove
            starts the drag; FavouritesPanel_Drop computes the new index
            and calls MainViewModel.MoveFavourite).
        -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Right-click a place below and choose &quot;Toggle Favourite&quot; to pin it here."
                       Foreground="{StaticResource Text.Faint}" FontStyle="Italic"
                       Visibility="{Binding FavouritePlaces.Count, Converter={StaticResource CollectionCountToVisibilityConverter}}" />

            <ItemsControl x:Name="FavouritesItemsControl" ItemsSource="{Binding FavouritePlaces}"
                          AllowDrop="True" DragOver="FavouritesItemsControl_DragOver" Drop="FavouritesItemsControl_Drop">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Button.Bubble}"
                                ToolTip="{Binding ToolTipText}"
                                Tag="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext}"
                                ContextMenu="{StaticResource BubbleContextMenu}"
                                Command="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.OpenCommand}"
                                CommandParameter="{Binding}"
                                PreviewMouseLeftButtonDown="Bubble_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="Bubble_PreviewMouseMove">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TypeGlyph}" Style="{StaticResource TextBlock.Glyph}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13" />
                                <TextBlock Text="{Binding Alias}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!--
            Grid header: place count, search box, and the collapse toggle.
            The search box stays visible while the grid is collapsed;
            typing into it re-expands the grid (see MainViewModel.SearchText).
        -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding PlacesHeader}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />

            <Grid Grid.Column="1" Margin="16,0,8,0" MaxWidth="360" HorizontalAlignment="Right" MinWidth="220">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"
                         ToolTip="Search by alias or path/URL (Ctrl+F). Enter opens the top result; Down moves into the list; Esc clears." />
                <!-- Placeholder text: hit-test invisible so clicks land on the TextBox underneath. -->
                <TextBlock Grid.Column="0" Text="Search places (Ctrl+F)" IsHitTestVisible="False"
                           Margin="9,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Text.Faint}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="1" Margin="6,0,0,0" Padding="8,4"
                        Command="{Binding ClearSearchCommand}" ToolTip="Clear search (Esc)"
                        Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource Font.Icons}" FontSize="10" />
                </Button>
            </Grid>

            <Button Grid.Column="2" Command="{Binding ToggleGridCommand}" ToolTip="Hide or show the list (Ctrl+H)">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Content" Value="Hide List" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGridExpanded}" Value="False">
                                <Setter Property="Content" Value="Show List" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!--
            Places grid (SI §6.3). Collapsible via the row's bound Height
            (Row 4 above) rather than just Visibility, so collapsing it
            actually reclaims the vertical space for the window instead of
            leaving a blank gap (see BoolToGridLengthConverter's remarks).
        -->
        <Grid Grid.Row="4">
            <DataGrid x:Name="PlacesGrid"
                      ItemsSource="{Binding PlacesView}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      PreviewKeyDown="PlacesGrid_PreviewKeyDown"
                      Sorting="PlacesGrid_Sorting">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Tag" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext}" />
                        <Setter Property="ContextMenu" Value="{StaticResource PlaceContextMenu}" />
                        <EventSetter Event="MouseDoubleClick" Handler="Row_MouseDoubleClick" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <!--
                        Every SortMemberPath is a PlaceSortKey name, read only
                        by PlacesGrid_Sorting, which replaces the DataGrid's own
                        sorting (Phase 3 D29) — so it names the key, not a
                        bound property.

                        Every width is proportional (a star value), so the
                        whole grid scales with the window rather than only
                        Alias and Path / URL absorbing a change. A fixed pixel
                        column never shrinks until the star columns are
                        crushed, and a column whose edge was dragged became a
                        fixed pixel one. MinWidth keeps each column readable
                        at the window's 700 px minimum. MaxWidth stops the
                        short columns spreading on a wide screen, leaving the
                        extra room to Alias and Path / URL, which have none.
                        The star column is the exception: an icon, so a fixed
                        48 px, just wide enough for its header star plus the
                        sort chevron.
                    -->
                    <!--
                        Favourite, as a star beside the alias: filled gold for a
                        favourite, an outline otherwise, and clicking it toggles
                        (the same command as Ctrl+D and the menu's Toggle
                        Favourite). Its header star sorts favourites first.
                    -->
                    <DataGridTemplateColumn SortMemberPath="Favourite" Width="48" CanUserResize="False"
                                            HeaderStyle="{StaticResource DataGridColumnHeader.Centered}">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="&#xE735;" FontFamily="{StaticResource Font.Icons}" FontSize="12"
                                       ToolTip="Favourites (click to sort)" AutomationProperties.Name="Favourite" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Button.GridIcon}"
                                        Command="{Binding DataContext.ToggleFavouriteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding FavouriteToolTip}"
                                        AutomationProperties.Name="{Binding FavouriteToolTip}">
                                    <TextBlock Text="{Binding FavouriteGlyph}" FontFamily="{StaticResource Font.Icons}" FontSize="14">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Text.Faint}" />
                                                <!-- Later triggers win: a favourite stays gold whether hovered or selected. -->
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                        <Setter Property="Foreground" Value="#CCFFFFFF" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsFavourite}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Favourite.Star}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- Template column so the type glyph can sit beside the alias. -->
                    <DataGridTemplateColumn Header="Alias" SortMemberPath="Alias" Width="2*" MinWidth="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TypeGlyph}" Style="{StaticResource TextBlock.Glyph}" />
                                    <TextBlock Text="{Binding Alias}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" SortMemberPath="Type" Width="0.7*" MinWidth="64" MaxWidth="100" />
                    <DataGridTextColumn Header="Path / URL" Binding="{Binding Resource}" SortMemberPath="Destination" Width="3*" MinWidth="140" />
                    <!--
                        Last Opened replaces Date Added, which is still stored
                        and exported (roadmap §4.13). Formatted in the view
                        model with the user's regional settings, not by a
                        StringFormat, which would ignore them (D31).
                    -->
                    <DataGridTextColumn Header="Last Opened" Binding="{Binding LastOpenedText}" SortMemberPath="LastOpened"
                                        Width="1.4*" MinWidth="128" MaxWidth="180" />
                    <DataGridTextColumn Header="Opens" Binding="{Binding OpenCount}" SortMemberPath="Opens"
                                        Width="0.6*" MinWidth="62" MaxWidth="90"
                                        HeaderStyle="{StaticResource DataGridColumnHeader.Centered}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Explains an empty grid: nothing saved yet, or nothing matches the search. -->
            <TextBlock Text="{Binding EmptyGridMessage}" IsHitTestVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,48,16,0"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{StaticResource Text.Faint}" FontStyle="Italic">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EmptyGridMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!--
            Status bar: a short confirmation after Remove (with Undo), Undo,
            Copy, or Recently Deleted. Hidden 10 s after a message offering
            Undo, 8 s after any other (D19); held open while the pointer is
            over it or the keyboard focus is inside it (the three handlers
            below), so reaching for Undo never races the timer. Like the
            banner, it never takes focus: Focusable="False" here, and
            nothing calls Focus() when it appears.
        -->
        <Border x:Name="StatusBar" Grid.Row="5" Margin="0,8,0,0" Padding="12,6" CornerRadius="8"
                Background="{StaticResource Bg.Elevated}" BorderBrush="{StaticResource Border.Default}" BorderThickness="1"
                Focusable="False"
                MouseEnter="StatusBar_MouseEnter"
                MouseLeave="StatusBar_MouseLeave"
                IsKeyboardFocusWithinChanged="StatusBar_IsKeyboardFocusWithinChanged">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="Undo" Margin="8,0,0,0" Padding="10,4"
                        Command="{Binding UndoRemoveCommand}" ToolTip="Restore it (Ctrl+Z)"
                        Visibility="{Binding StatusOffersUndo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button Grid.Column="2" Margin="6,0,0,0" Padding="8,4"
                        Command="{Binding DismissStatusCommand}" ToolTip="Dismiss"
                        AutomationProperties.Name="Dismiss">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource Font.Icons}" FontSize="10" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
