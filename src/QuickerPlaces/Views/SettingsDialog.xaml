<Window x:Class="QuickerPlaces.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="480"
        WindowStartupLocation="CenterOwner">
    <!--
        App settings: appearance (previewed live, reverted on Cancel), the
        global hotkey, and the tray and Windows startup opt-ins. Window size
        and the list's collapsed state are remembered automatically.
    -->
    <Window.Resources>
        <!-- A full-width button that opens more settings: its icon, its name and a chevron. -->
        <Style x:Key="SettingsLink" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12,0,8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            The sections scroll when the window is capped at the work area's
            height (set in code), so the error text and the buttons below
            them always stay on screen.
        -->
        <ScrollViewer x:Name="SectionsScroller" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="24,22,24,0">
                <TextBlock Text="APPEARANCE" Style="{StaticResource TextBlock.Caps}" HorizontalAlignment="Left" />

                <TextBlock Text="Theme" Style="{StaticResource TextBlock.FieldLabel}" Margin="0,12,0,8" />
                <GroupBox Style="{StaticResource GroupBox.Unstyled}" AutomationProperties.Name="Theme">
                    <Border Style="{StaticResource Border.SegmentGroup}">
                        <UniformGrid Rows="1">
                            <RadioButton x:Name="ThemeLight" GroupName="Theme" Style="{StaticResource RadioButton.Segment}" Tag="5,0,0,5"
                                         Checked="Appearance_Changed" AutomationProperties.Name="Light theme">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Sun}" />
                                    <TextBlock Text="Light" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ThemeDark" GroupName="Theme" Style="{StaticResource RadioButton.Segment}" Tag="0"
                                         Checked="Appearance_Changed" AutomationProperties.Name="Dark theme">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Moon}" />
                                    <TextBlock Text="Dark" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ThemeSystem" GroupName="Theme" Style="{StaticResource RadioButton.Segment}" Tag="0,5,5,0"
                                         BorderThickness="0" Checked="Appearance_Changed" AutomationProperties.Name="Match Windows theme">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Monitor}" />
                                    <TextBlock Text="Match Windows" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </Border>
                </GroupBox>

                <TextBlock Text="Highlight colour" Style="{StaticResource TextBlock.FieldLabel}" Margin="0,20,0,2" />
                <TextBlock Text="Colours the main buttons, the QP badge, selected rows, switches and the sort arrow." Style="{StaticResource TextBlock.Hint}" />
                <GroupBox Style="{StaticResource GroupBox.Unstyled}" Margin="0,12,0,0" AutomationProperties.Name="Highlight colour">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="HighlightGreen" GroupName="Highlight" Style="{StaticResource RadioButton.Swatch}"
                                     Background="{DynamicResource Preset.Green}" Checked="Appearance_Changed" AutomationProperties.Name="Hull green">
                            <TextBlock Text="Hull green" TextWrapping="Wrap" TextAlignment="Center" />
                        </RadioButton>
                        <RadioButton x:Name="HighlightBlue" GroupName="Highlight" Style="{StaticResource RadioButton.Swatch}"
                                     Background="{DynamicResource Preset.Blue}" Checked="Appearance_Changed" AutomationProperties.Name="Steel blue">
                            <TextBlock Text="Steel blue" TextWrapping="Wrap" TextAlignment="Center" />
                        </RadioButton>
                        <RadioButton x:Name="HighlightRed" GroupName="Highlight" Style="{StaticResource RadioButton.Swatch}"
                                     Background="{DynamicResource Preset.Red}" Checked="Appearance_Changed" AutomationProperties.Name="Tail red">
                            <TextBlock Text="Tail red" TextWrapping="Wrap" TextAlignment="Center" />
                        </RadioButton>
                        <RadioButton x:Name="HighlightCognac" GroupName="Highlight" Style="{StaticResource RadioButton.Swatch}"
                                     Background="{DynamicResource Preset.Cognac}" Checked="Appearance_Changed" AutomationProperties.Name="Cognac">
                            <TextBlock Text="Cognac" TextWrapping="Wrap" TextAlignment="Center" />
                        </RadioButton>
                        <RadioButton x:Name="HighlightWindows" GroupName="Highlight" Style="{StaticResource RadioButton.Swatch}" Tag="windows"
                                     Background="{DynamicResource Bg.Raised}" Checked="Appearance_Changed" AutomationProperties.Name="Windows accent colour">
                            <TextBlock Text="Windows accent" TextWrapping="Wrap" TextAlignment="Center" />
                        </RadioButton>
                    </StackPanel>
                </GroupBox>

                <!-- Customise layout sits with the other look-and-feel choices; it has its own panel so it hides alone. -->
                <StackPanel x:Name="LayoutArea">
                    <TextBlock Text="Panels" Style="{StaticResource TextBlock.FieldLabel}" Margin="0,20,0,2" />
                    <TextBlock Text="Move, hide or add panels, or pick another layout. Customise layout saves these settings first."
                               Style="{StaticResource TextBlock.Hint}" />
                    <UniformGrid Columns="2" Margin="-4,8,-4,0">
                        <Button x:Name="CustomiseLayoutButton" Style="{StaticResource SettingsLink}" Click="CustomiseLayout_Click"
                                AutomationProperties.Name="Customise layout"
                                ToolTip="Move, hide or add panels, or pick another layout. Reset to Desk puts everything back.">
                            <DockPanel>
                                <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource Icon.Arrange}" Margin="0,0,9,0" />
                                <Path DockPanel.Dock="Right" Style="{StaticResource Icon}" Data="{StaticResource Icon.ChevronRight}" Stroke="{DynamicResource Text.Tertiary}" />
                                <TextBlock Text="Customise layout" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <Separator />

                <TextBlock Text="SHORTCUT" Style="{StaticResource TextBlock.Caps}" HorizontalAlignment="Left" />
                <TextBlock Text="Bring QuickerPlaces to the front" Style="{StaticResource TextBlock.FieldLabel}" Margin="0,12,0,2" />
                <TextBlock Text="Works from any app while QuickerPlaces is running. Click the box, then press the keys you want, including Ctrl, Alt or Win."
                           Style="{StaticResource TextBlock.Hint}" />
                <!--
                    Read-only so typing never inserts characters: the key handler
                    turns each key press into a hotkey. Tab, and Enter/Esc with no
                    modifiers, are let through so the dialog stays keyboard-usable.
                -->
                <TextBox x:Name="HotkeyBox" Margin="0,10,0,0"
                         IsReadOnly="True" IsReadOnlyCaretVisible="False"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         PreviewKeyUp="HotkeyBox_PreviewKeyUp"
                         AutomationProperties.Name="Global shortcut"
                         ToolTip="Press a key combination. Backspace turns the shortcut off." />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Reset to default" Style="{StaticResource Button.Compact}" Margin="0,0,8,0" Click="ResetButton_Click" />
                    <Button Content="Turn off" Style="{StaticResource Button.Compact}" Click="TurnOffButton_Click" />
                </StackPanel>

                <StackPanel x:Name="WorkspaceSection">
                    <Separator />

                    <TextBlock Text="TRACKING AND REVIT" Style="{StaticResource TextBlock.Caps}" HorizontalAlignment="Left" />
                    <!--
                        Two even columns of SettingsLink buttons: Recent files beside
                        Folder activity, then Revit beside Session suggestions. UniformGrid skips the collapsed
                        ones, so the rest still fill the grid in order.
                    -->
                    <UniformGrid Columns="2" Margin="-4,8,-4,0">
                        <Button x:Name="RecentFilesButton" Style="{StaticResource SettingsLink}" Click="RecentFiles_Click"
                                AutomationProperties.Name="Recent files"
                                ToolTip="Record the PDF, Office, text, Revit and AutoCAD files you open, and which">
                            <DockPanel>
                                <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource Icon.Document}" Margin="0,0,9,0" />
                                <Path DockPanel.Dock="Right" Style="{StaticResource Icon}" Data="{StaticResource Icon.ChevronRight}" Stroke="{DynamicResource Text.Tertiary}" />
                                <TextBlock Text="Recent files" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Button>
                        <Button x:Name="FolderActivityButton" Style="{StaticResource SettingsLink}" Click="FolderActivity_Click"
                                AutomationProperties.Name="Folder activity"
                                ToolTip="Record visits in target folders only, or in all folders.">
                            <DockPanel>
                                <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource Icon.Folder}" Margin="0,0,9,0" />
                                <Path DockPanel.Dock="Right" Style="{StaticResource Icon}" Data="{StaticResource Icon.ChevronRight}" Stroke="{DynamicResource Text.Tertiary}" />
                                <TextBlock Text="Folder activity" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Button>
                        <Button x:Name="RevitButton" Style="{StaticResource SettingsLink}" Click="Revit_Click"
                                AutomationProperties.Name="Revit"
                                ToolTip="Choose how central models are opened, the folder for new locals, and the add-in prompts QuickerPlaces may answer.">
                            <DockPanel>
                                <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource Icon.RevitModel}" Margin="0,0,9,0" />
                                <Path DockPanel.Dock="Right" Style="{StaticResource Icon}" Data="{StaticResource Icon.ChevronRight}" Stroke="{DynamicResource Text.Tertiary}" />
                                <TextBlock Text="Revit" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Button>
                        <Button x:Name="SuggestionsButton" Style="{StaticResource SettingsLink}" Click="Suggestions_Click"
                                AutomationProperties.Name="Session suggestions"
                                ToolTip="Review suggested sessions and adjust their sensitivity. Follows your tracked file types and folder scope.">
                            <DockPanel>
                                <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource Icon.Settings}" Margin="0,0,9,0" />
                                <Path DockPanel.Dock="Right" Style="{StaticResource Icon}" Data="{StaticResource Icon.ChevronRight}" Stroke="{DynamicResource Text.Tertiary}" />
                                <TextBlock Text="Session suggestions" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <Separator />

                <TextBlock Text="TRAY" Style="{StaticResource TextBlock.Caps}" HorizontalAlignment="Left" />
                <CheckBox x:Name="MinimizeToTrayCheck" Content="Keep running in the tray when I close the window" Margin="0,12,0,10" />
                <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows in the tray" />
                <TextBlock Text="Both are off by default. The tray menu has Open, Pause tracking and Exit."
                           Style="{StaticResource TextBlock.Hint}" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="ErrorText" Grid.Row="1" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"
                   Margin="24,14,24,0" Visibility="Collapsed" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,22,24,20">
            <Button Content="Cancel" Margin="0,0,8,0" IsCancel="True" Click="CancelButton_Click" />
            <Button Content="Save" Style="{StaticResource Button.Primary}" IsDefault="True" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
