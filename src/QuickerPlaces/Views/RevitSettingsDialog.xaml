<Window x:Class="QuickerPlaces.Views.RevitSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revit"
        Width="640" SizeToContent="Height" MinWidth="520" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <!--
        Revit opening (roadmap 4.21): per release, the handler that opens a
        central as a new local and the folder for the new locals; then the
        opt-in for pressing Load Once on add-in security prompts, with the
        add-ins already allowed. A draft: nothing changes until Save.
    -->
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Revit" Style="{StaticResource TextBlock.WindowTitle}" />
            <TextBlock Text="Choose how QuickerPlaces opens central models, and which add-in security prompts it may answer. Save applies your selections and closes this panel."
                       Foreground="{DynamicResource Text.Secondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
            <Control Style="{StaticResource TrimBand}" Margin="-20,14,-20,14" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="CENTRAL MODELS" Style="{StaticResource TextBlock.Caps}" HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource TextBlock.Hint}" Margin="0,6,0,0"
                           Text="A central model is opened as a new local copy, made by Revit itself through a handler add-in. A handler appears in the list only after Revit has run once with it loaded." />
                <TextBlock Text="{Binding NoReleasesText}" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"
                           Margin="0,10,0,0" Style="{StaticResource CollapsedWhenEmpty}" />
                <ItemsControl ItemsSource="{Binding Releases}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                    CornerRadius="8" Padding="14,12" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="{Binding InstalledNote}" Foreground="{DynamicResource Signal}" FontSize="12.5" TextWrapping="Wrap"
                                               Margin="0,2,0,0" Style="{StaticResource CollapsedWhenEmpty}" />
                                    <TextBlock Text="Handler" Style="{StaticResource TextBlock.FieldLabel}" Margin="0,10,0,4" />
                                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" DisplayMemberPath="Label"
                                              AutomationProperties.Name="{Binding Title, StringFormat=Handler for {0}}" />
                                    <TextBlock Text="{Binding HandlerHint}" Style="{StaticResource TextBlock.Hint}" Margin="0,4,0,0" />
                                    <TextBlock Text="Local folder" Style="{StaticResource TextBlock.FieldLabel}" Margin="0,10,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <TextBox Text="{Binding LocalFolder, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="{Binding Title, StringFormat=Local folder for {0}}"
                                                     AutomationProperties.HelpText="{Binding DefaultFolder, StringFormat=Leave empty to use {0}}" />
                                            <!-- The default, greyed in the empty box. -->
                                            <TextBlock Text="{Binding DefaultFolder}" IsHitTestVisible="False" Margin="9,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LocalFolder}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <Button Grid.Column="1" Content="Reset" Style="{StaticResource Button.Compact}" Margin="8,0,0,0"
                                                IsEnabled="{Binding CanReset}" Click="ResetFolder_Click"
                                                AutomationProperties.Name="{Binding Title, StringFormat=Reset the local folder for {0} to its default}" />
                                    </Grid>
                                    <TextBlock Text="{Binding FolderError}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"
                                               Margin="0,4,0,0" Style="{StaticResource CollapsedWhenEmpty}" AutomationProperties.LiveSetting="Assertive" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator />

                <TextBlock Text="ADD-IN SECURITY PROMPTS" Style="{StaticResource TextBlock.Caps}" HorizontalAlignment="Left" />
                <CheckBox Content="Allow Load Once" IsChecked="{Binding AllowLoadOnce}" FontWeight="SemiBold" Margin="0,12,0,0" />
                <TextBlock Text="{Binding AllowLoadOnceHint}" Style="{StaticResource TextBlock.Hint}" Margin="28,4,0,0" />
                <TextBlock Text="Allowed add-ins" Style="{StaticResource TextBlock.FieldLabel}" Margin="0,14,0,6" />
                <TextBlock Text="{Binding NoEntriesText}" Foreground="{DynamicResource Text.Secondary}" FontSize="12.5" TextWrapping="Wrap"
                           Style="{StaticResource CollapsedWhenEmpty}" />
                <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                            <Run Text="{Binding Name, Mode=OneTime}" /><Run Text="  " /><Run Text="{Binding ReleaseText, Mode=OneTime}" Foreground="{DynamicResource Text.Secondary}" FontWeight="Normal" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding DllPath}" Style="{StaticResource TextBlock.Hint}" TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" ToolTip="{Binding DllPath}" />
                                        <TextBlock Text="{Binding AllowedText}" Style="{StaticResource TextBlock.Hint}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Remove" Style="{StaticResource Button.Compact}" VerticalAlignment="Center"
                                            Margin="12,0,0,0" Click="RemoveEntry_Click" AutomationProperties.Name="{Binding RemoveName}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"
                           Margin="0,10,0,0" Style="{StaticResource CollapsedWhenEmpty}" AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SaveStatus}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                       AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Signal}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Close" MinWidth="84" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="Save" Style="{StaticResource Button.Primary}" MinWidth="84"
                        IsDefault="True" IsEnabled="{Binding CanSave}" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
