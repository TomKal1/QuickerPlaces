<Window x:Class="QuickerPlaces.Views.ActivityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder Activity"
        Width="900" Height="720" MinWidth="650" MinHeight="660"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        PreviewKeyDown="ActivityWindow_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="ActivityCellText.Centered" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="ActivityCellText.Folder" TargetType="TextBlock"
               BasedOn="{StaticResource ActivityCellText.Centered}">
            <Setter Property="TextAlignment" Value="Left" />
        </Style>
        <Style x:Key="Button.CalendarYear" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="YearBackground" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="YearBackground" Property="Background" Value="{DynamicResource Highlight.Soft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Button.CalendarDay" TargetType="Button">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
            <Setter Property="Background" Value="{DynamicResource Bg.Raised}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2" />
                            <Border x:Name="TodayOutline"
                                    BorderBrush="{DynamicResource Info}"
                                    BorderThickness="1" CornerRadius="2"
                                    Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="TodayOutline" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Intensity}" Value="-1">
                    <Setter Property="Background" Value="{DynamicResource Text.Tertiary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Intensity}" Value="1">
                    <Setter Property="Background" Value="#FF30265A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Intensity}" Value="2">
                    <Setter Property="Background" Value="#FF514091" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Intensity}" Value="3">
                    <Setter Property="Background" Value="#FF7357CE" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Intensity}" Value="4">
                    <Setter Property="Background" Value="{DynamicResource Highlight.Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Text.Primary}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInRange}" Value="False">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TrackedFolderCard" TargetType="ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource Bg.Raised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="{Binding TrackingToolTip}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Highlight}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource Highlight.Soft}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Highlight}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Highlight.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Folder Activity" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Only the active File Explorer window is tracked. Return here to see new visits."
                       Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource Signal}"
                       TextWrapping="Wrap" Margin="0,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Notice}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Notice}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                CornerRadius="10" Padding="8" Margin="0,0,0,8">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="+ Folders" Click="AddRoot_Click"
                        IsEnabled="{Binding CanManage}" ToolTip="Add a folder to track"
                        Margin="10,0,0,0" />
                <TextBlock DockPanel.Dock="Left" Text="Tracked folders" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="4,0,14,0" />
                <Grid VerticalAlignment="Center">
                <ListBox x:Name="TrackedFoldersList" ItemsSource="{Binding Roots}"
                         SelectedItem="{Binding SelectedRoot, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource TrackedFolderCard}"
                         BorderThickness="0" Background="Transparent" Padding="0"
                         MaxHeight="78" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ContextMenuOpening="TrackedFoldersList_ContextMenuOpening"
                         AutomationProperties.Name="Tracked folders"
                         Visibility="{Binding HasRoots, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Edit tracking settings…" Click="EditTrackedFolder_Click" />
                            <MenuItem Header="About folder…" Tag="ReadOnly" Click="AboutTrackedFolder_Click" />
                            <Separator />
                            <MenuItem Header="Stop tracking" Tag="ToggleTracking" Click="Toggle_Click" />
                            <Separator />
                            <MenuItem Header="Delete tracked folder…" Click="Delete_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Font.Icons}"
                                           Foreground="{DynamicResource Highlight.Text}" FontSize="13" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding Path}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                <TextBlock Text="Paused" Foreground="{DynamicResource Text.Secondary}"
                                           Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="No tracked folders yet. Add one to start tracking."
                           Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRoots}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource Bg.Raised}"
                BorderBrush="{DynamicResource Danger}" BorderThickness="1"
                CornerRadius="8" Padding="10" Margin="0,0,0,12"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Retry save" Click="RetrySave_Click"
                        Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="10,0,0,0" />
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Danger}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource Bg.Base}"
                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="8">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource Bg.Panel}"
                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                            CornerRadius="8" Padding="8" Margin="0,0,0,10"
                            Visibility="{Binding HasRoots, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,5">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Previous" Click="PreviousPeriod_Click"
                                            ToolTip="Previous activity period" Margin="0,0,6,0" />
                                    <Button Content="Next" Click="NextPeriod_Click"
                                            IsEnabled="{Binding CanMoveNext}" ToolTip="Next activity period" />
                                    <Border Width="1" Background="{DynamicResource Border.Strong}"
                                            Margin="10,5" />
                                    <Button x:Name="CalendarYearButton" Content="{Binding CalendarYear}"
                                            Style="{StaticResource Button.CalendarYear}"
                                            Click="CalendarYearButton_Click" Padding="6,3"
                                            FontWeight="SemiBold" ToolTip="Click to choose an activity year"
                                            AutomationProperties.HelpText="Opens a scrollable list of activity years" />
                                    <Popup x:Name="CalendarYearPopup" PlacementTarget="{Binding ElementName=CalendarYearButton}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <Border Background="{DynamicResource Bg.Raised}"
                                                BorderBrush="{DynamicResource Border.Strong}"
                                                BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,4,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Activity year" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                <ListBox x:Name="CalendarYearList" Width="96" Height="220"
                                                         Background="{DynamicResource Bg.Raised}"
                                                         BorderThickness="0"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         VirtualizingPanel.IsVirtualizing="True"
                                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                                         PreviewMouseLeftButtonUp="CalendarYearList_PreviewMouseLeftButtonUp"
                                                         KeyDown="CalendarYearList_KeyDown"
                                                         AutomationProperties.Name="Choose activity year">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                                            <Setter Property="Padding" Value="10,5" />
                                                            <Setter Property="Cursor" Value="Hand" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                        <Border x:Name="YearItemBackground" Background="Transparent"
                                                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="YearItemBackground" Property="Background" Value="{DynamicResource Bg.Panel}" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsSelected" Value="True">
                                                                                <Setter TargetName="YearItemBackground" Property="Background" Value="{DynamicResource Highlight.Soft}" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                </ListBox>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Year activity" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Margin="0,0,12,0" ToolTip="Outlined bubbles match the period shown in the table." />
                                    <Button Content="Week" Click="Week_Click" Margin="0,0,6,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWeekMode}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Highlight.Soft}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Highlight}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Month" Click="Month_Click" Margin="0,0,6,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMonthMode}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Highlight.Soft}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Highlight}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Day" Click="Day_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDayMode}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Highlight.Soft}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Highlight}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Grid.Row="1" HorizontalAlignment="Center">
                                    <ItemsControl x:Name="CalendarWeekdayLabels" DockPanel.Dock="Left" ItemsSource="{Binding CalendarWeekdayLabels}"
                                                  Margin="0,19,7,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Height="14" FontSize="9"
                                                           Foreground="{DynamicResource Text.Secondary}"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                <ScrollViewer x:Name="CalendarScroll" Height="140" Focusable="True" HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <Grid Width="{Binding CalendarStripWidth}" Height="117">
                                        <ItemsControl ItemsSource="{Binding CalendarWeeks}" Margin="0,19,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ItemsControl ItemsSource="{Binding Days}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource Button.CalendarDay}"
                                                                        ToolTip="{Binding Label}"
                                                                        AutomationProperties.Name="{Binding Label}"
                                                                        Click="CalendarDay_Click" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding CalendarMonthMarkers}" IsHitTestVisible="False"
                                                      Width="{Binding CalendarStripWidth}" Height="117">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Canvas Width="{Binding DataContext.CalendarStripWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            Height="117">
                                                        <Polyline Points="{Binding Points}"
                                                                  Stroke="{DynamicResource Border.Strong}" StrokeThickness="1" />
                                                        <TextBlock Text="{Binding Label}" Canvas.Left="{Binding LabelX}"
                                                                   FontSize="10" Foreground="{DynamicResource Text.Secondary}" />
                                                    </Canvas>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="{Binding PeriodLabel}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PeriodSummary}" Foreground="{DynamicResource Text.Secondary}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{Binding EmptyPeriodText}"
                               Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPeriodRows}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <CheckBox x:Name="GroupByLevel" Grid.Row="3" Content="Group by folder level"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,10"
                              Checked="GroupByLevel_Changed" Unchecked="GroupByLevel_Changed"
                              ToolTip="Group recorded folders by depth below the tracked root. This only changes the display."
                              AutomationProperties.Name="Group activity by folder level" />
                    <DataGrid x:Name="ActivityGrid" Grid.Row="4" ItemsSource="{Binding PeriodRows}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" Sorting="ActivityGrid_Sorting"
                              ColumnHeaderStyle="{StaticResource DataGridColumnHeader.Centered}">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Bg.Panel}" Padding="10,7" Margin="0,7,0,2"
                                                BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,0,1">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ItemCount, StringFormat='  ·  {0} folders'}"
                                                           Foreground="{DynamicResource Text.Secondary}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Folder" Binding="{Binding Folder}"
                                                ElementStyle="{StaticResource ActivityCellText.Folder}"
                                                SortMemberPath="Folder" Width="3*" MinWidth="140" />
                            <DataGridTextColumn Header="Visits" Binding="{Binding Visits}"
                                                ElementStyle="{StaticResource ActivityCellText.Centered}"
                                                SortMemberPath="Visits" Width="0.7*" MinWidth="64" />
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeText}"
                                                ElementStyle="{StaticResource ActivityCellText.Centered}"
                                                SortMemberPath="Time" Width="0.9*" MinWidth="80" />
                            <DataGridTextColumn Header="Last visited" Binding="{Binding LastVisitedText}"
                                                ElementStyle="{StaticResource ActivityCellText.Centered}"
                                                SortMemberPath="LastVisited" Width="1.4*" MinWidth="130" />
                            <DataGridTemplateColumn Header="Place" Width="Auto" MinWidth="110" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Add as Place" Click="AddAsPlace_Click"
                                                HorizontalAlignment="Center"
                                                ToolTip="Add this folder to the main Places list" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
        </Border>

        <Button Grid.Row="4" Content="Close" HorizontalAlignment="Right" IsCancel="True"
                Click="Close_Click" Margin="0,6,0,0" />
        <Border x:Name="StatusRibbon" Grid.Row="5" Margin="0,6,0,0" Padding="12,6" CornerRadius="8"
                Background="{DynamicResource Bg.Raised}" BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1" Focusable="False" MouseEnter="StatusRibbon_MouseEnter"
                MouseLeave="StatusRibbon_MouseLeave"
                IsKeyboardFocusWithinChanged="StatusRibbon_IsKeyboardFocusWithinChanged">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Dismiss" Click="DismissStatus_Click"
                        Padding="8,4" Margin="8,0,0,0" />
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
