<Window x:Class="QuickerPlaces.Views.ActivityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder Activity"
        Width="840" Height="660" MinWidth="650" MinHeight="540"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="Button.CalendarDay" TargetType="Button">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource Border.Strong}" />
            <Setter Property="Background" Value="{StaticResource Bg.Elevated}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Intensity}" Value="-1">
                    <Setter Property="Background" Value="{StaticResource Text.Faint}" />
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Intensity}" Value="1">
                    <Setter Property="Background" Value="#FF30265A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Intensity}" Value="2">
                    <Setter Property="Background" Value="#FF514091" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Intensity}" Value="3">
                    <Setter Property="Background" Value="#FF7357CE" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Intensity}" Value="4">
                    <Setter Property="Background" Value="{StaticResource Accent.Hover}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInRange}" Value="False">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Folder Activity" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Choose which folders QuickerPlaces tracks while it is running."
                       Foreground="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding Notice}" Foreground="{StaticResource Status.Warning}"
                       TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource Bg.Panel}"
                BorderBrush="{StaticResource Border.Default}" BorderThickness="1"
                CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Tracked roots" FontWeight="SemiBold" Margin="0,0,0,8" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Add root…" Click="AddRoot_Click"
                            IsEnabled="{Binding CanManage}" Margin="10,0,0,0" />
                    <ComboBox ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedRoot, Mode=TwoWay}"
                              DisplayMemberPath="Path" MinWidth="280"
                              AutomationProperties.Name="Tracked root" />
                </DockPanel>
                <TextBlock Text="No roots yet. Add one to start tracking."
                           Foreground="{StaticResource Text.Secondary}" Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRoots}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource Bg.Elevated}"
                BorderBrush="{StaticResource Status.Error}" BorderThickness="1"
                CornerRadius="8" Padding="10" Margin="0,0,0,12"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Retry save" Click="RetrySave_Click"
                        Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="10,0,0,0" />
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                           Foreground="{StaticResource Status.Error}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TabControl Grid.Row="3">
            <TabItem x:Name="ActivityTab" Header="Activity">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Previous" Click="PreviousPeriod_Click" Margin="0,0,8,0" />
                            <Button Content="Next" Click="NextPeriod_Click" IsEnabled="{Binding CanMoveNext}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Week" Click="Week_Click" Margin="0,0,6,0" />
                            <Button Content="Month" Click="Month_Click" Margin="0,0,12,0" />
                            <DatePicker x:Name="DayPicker" Width="130" SelectedDateChanged="DayPicker_SelectedDateChanged"
                                        AutomationProperties.Name="Choose a day" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="{Binding PeriodLabel}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PeriodSummary}" Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,3,0,0" />
                        <TextBlock Text="{Binding PeriodNotice}" Foreground="{StaticResource Status.Warning}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{Binding EmptyPeriodText}"
                               Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPeriodRows}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DataGrid x:Name="ActivityGrid" Grid.Row="3" ItemsSource="{Binding PeriodRows}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" Sorting="ActivityGrid_Sorting">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Folder" Binding="{Binding Folder}"
                                                SortMemberPath="Folder" Width="3*" MinWidth="140" />
                            <DataGridTextColumn Header="Visits" Binding="{Binding Visits}"
                                                SortMemberPath="Visits" Width="0.7*" MinWidth="64" />
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeText}"
                                                SortMemberPath="Time" Width="0.9*" MinWidth="80" />
                            <DataGridTextColumn Header="Last visited" Binding="{Binding LastVisitedText}"
                                                SortMemberPath="LastVisited" Width="1.4*" MinWidth="130" />
                            <DataGridTemplateColumn Header="Place" Width="Auto" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Add as Place" Click="AddAsPlace_Click"
                                                ToolTip="Add this folder to the main Places list" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Calendar">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Last 365 days · choose a day to see its folders"
                               Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,16" />
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding CalendarWeekdayLabels}" Margin="0,0,8,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Height="14" FontSize="9"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding CalendarWeeks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Days}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource Button.CalendarDay}"
                                                            ToolTip="{Binding Label}"
                                                            AutomationProperties.Name="{Binding Label}"
                                                            Click="CalendarDay_Click" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="Less" Foreground="{StaticResource Text.Secondary}" Margin="0,0,7,0" />
                        <Border Width="12" Height="12" Background="{StaticResource Bg.Elevated}" Margin="0,0,4,0" />
                        <Border Width="12" Height="12" Background="#FF30265A" Margin="0,0,4,0" />
                        <Border Width="12" Height="12" Background="#FF514091" Margin="0,0,4,0" />
                        <Border Width="12" Height="12" Background="#FF7357CE" Margin="0,0,4,0" />
                        <Border Width="12" Height="12" Background="{StaticResource Accent.Hover}" Margin="0,0,7,0" />
                        <TextBlock Text="More" Foreground="{StaticResource Text.Secondary}" Margin="0,0,18,0" />
                        <Border Width="12" Height="12" Background="{StaticResource Text.Faint}" Margin="0,0,5,0" />
                        <TextBlock Text="Not tracked" Foreground="{StaticResource Text.Secondary}" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Root settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
            <StackPanel IsEnabled="{Binding HasSelection}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="{Binding SelectedStatusText}" FontWeight="SemiBold" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding TrackingStartedText}" Foreground="{StaticResource Text.Secondary}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Button Content="{Binding ToggleLabel}" Click="Toggle_Click" Margin="0,0,8,0" />
                    <Button Content="Delete root and its data" Click="Delete_Click" />
                </StackPanel>

                <TextBlock Text="Folder grouping" FontWeight="SemiBold" Margin="0,0,0,5" />
                <ComboBox ItemsSource="{Binding RollupOptions}" SelectedItem="{Binding SelectedRollupOption, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          AutomationProperties.Name="Folder grouping" Margin="0,0,0,12" />
                <TextBlock Text="Root child groups folders by the first level; Exact keeps each folder; Depth groups by the number of levels below."
                           TextWrapping="Wrap" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,16" />

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" IsEnabled="{Binding IsDepthRollup}">
                        <TextBlock Text="Depth" Margin="0,0,0,5" />
                        <TextBox Text="{Binding DepthText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Grouping depth" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Visit threshold (seconds)" Margin="0,0,0,5" />
                        <TextBox Text="{Binding DwellSecondsText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Visit threshold in seconds" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Idle timeout (minutes)" Margin="0,0,0,5" />
                        <TextBox Text="{Binding IdleMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Idle timeout in minutes" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Equivalent paths" FontWeight="SemiBold" Margin="0,0,0,5" />
                <TextBlock Text="Enter one alternate path to this same root per line, such as a network path for a mapped drive."
                           TextWrapping="Wrap" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                <TextBox Text="{Binding EquivalentPrefixesText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="NoWrap" Height="76"
                         VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource Font.Mono}"
                         AutomationProperties.Name="Equivalent paths" />
                <Button Content="Save root settings" Style="{StaticResource Button.Primary}"
                        HorizontalAlignment="Left" Click="SaveSettings_Click" Margin="0,14,0,0" />
            </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Button Grid.Row="4" Content="Close" HorizontalAlignment="Right" IsCancel="True"
                Click="Close_Click" Margin="0,16,0,0" />
    </Grid>
</Window>
