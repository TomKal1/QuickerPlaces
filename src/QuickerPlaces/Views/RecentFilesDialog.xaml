<Window x:Class="QuickerPlaces.Views.RecentFilesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="clr-namespace:QuickerPlaces.Views.Panels"
        Title="Recent Files"
        Width="720" SizeToContent="Height" MinWidth="560" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
        <TextBlock Text="Recent Files" Style="{StaticResource TextBlock.WindowTitle}" />
        <TextBlock Text="Choose which files to record and where. Save applies your selections and closes this panel."
                   Foreground="{DynamicResource Text.Secondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
        <Control Style="{StaticResource TrimBand}" Margin="-20,14,-20,14" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
        <panels:RecentFilesSettings />
        <Border Background="{DynamicResource Highlight.Soft}" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
            <TextBlock Text="{Binding SelectionSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
        </Border>
        <TextBlock Text="Changes here are saved separately from the main Settings window. Turning recording off keeps your existing history."
                   Style="{StaticResource TextBlock.Hint}" Margin="0,8,0,0" />
        <TextBlock Text="{Binding RecentFilesNotice}" Foreground="{DynamicResource Signal}" TextWrapping="Wrap"
                   Margin="0,10,0,0" Style="{StaticResource CollapsedWhenEmpty}" />
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"
                   Margin="0,10,0,0" Style="{StaticResource CollapsedWhenEmpty}" AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SaveStatus}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                       AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Signal}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Close" MinWidth="84" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="Save" Style="{StaticResource Button.Primary}" MinWidth="84"
                        IsDefault="True" IsEnabled="{Binding CanSave}" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
