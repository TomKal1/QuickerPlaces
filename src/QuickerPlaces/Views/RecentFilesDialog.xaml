<Window x:Class="QuickerPlaces.Views.RecentFilesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="clr-namespace:QuickerPlaces.Views.Panels"
        Title="Recent Files"
        Width="720" SizeToContent="Height" MinWidth="560" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!--
        Recent Files' settings from the workspace (configurable canvas plan
        M3), where the Library window's expander isn't shown. DataContext is
        the workspace's LibraryViewModel, so a change shows on the shelf and
        the year strip at once.
    -->
    <StackPanel Margin="20,18,20,16">
        <TextBlock Text="Recent Files" Style="{StaticResource TextBlock.WindowTitle}" />
        <TextBlock Text="{Binding RecentFilesStatus}" Foreground="{DynamicResource Text.Secondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
        <Control Style="{StaticResource TrimBand}" Margin="-20,14,-20,14" />

        <panels:RecentFilesSettings />

        <TextBlock Text="{Binding RecentFilesNotice}" Foreground="{DynamicResource Signal}" TextWrapping="Wrap"
                   Margin="0,10,0,0" Style="{StaticResource CollapsedWhenEmpty}" />

        <Button Content="Close" MinWidth="84" HorizontalAlignment="Right" Margin="0,14,0,0" IsCancel="True" />
    </StackPanel>
</Window>
