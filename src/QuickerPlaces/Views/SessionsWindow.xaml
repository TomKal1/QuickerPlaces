<Window x:Class="QuickerPlaces.Views.SessionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Sessions"
        Width="940" Height="620" MinWidth="720" MinHeight="460"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!--
        Sessions plan §5. A thin view over SessionsViewModel, as the Recently
        Deleted dialog is over its own: the list of saved sessions on the
        left, with a search box and tag chips above it; the selected
        session's PDFs on the right, with Open all, Edit and Delete; Save
        open PDFs in the header. The code-behind only asks before Delete and
        shows the Save Session dialog.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- A tag in the filter row: a pill, filled while it is the chosen filter. -->
        <Style x:Key="Button.TagChip" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
            <Setter Property="Background" Value="{StaticResource Bg.Elevated}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border.Strong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent.Soft}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                    <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A session's tags, shown small beside it. -->
        <DataTemplate x:Key="TagPill">
            <Border Background="{StaticResource Accent.Soft}" CornerRadius="8" Padding="7,1" Margin="0,0,4,2">
                <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource Text.Primary}" />
            </Border>
        </DataTemplate>

        <!-- One saved session in the list: a card, like the tracked folders in Recents. -->
        <Style x:Key="SessionCard" TargetType="ListBoxItem">
            <Setter Property="Background" Value="{StaticResource Bg.Elevated}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource Accent.Soft}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource Accent.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CollapsedWhenEmpty" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: what this is, and the one main action. -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Project Sessions" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="Save the PDFs you have open as a tagged session, then reopen them together later."
                           Foreground="{StaticResource Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Notice}" Foreground="{StaticResource Status.Warning}"
                           TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource CollapsedWhenEmpty}" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="SaveOpenButton" Content="_Save open PDFs…"
                    Style="{StaticResource Button.Primary}" VerticalAlignment="Top" Margin="12,0,0,0"
                    IsEnabled="{Binding CanChange}"
                    ToolTip="Find the PDFs open now, check the list, and save them as a session"
                    Click="SaveOpen_Click" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: search, tags, and the sessions. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search sessions"
                             ToolTip="Search by session name, tag or PDF name" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                    <TextBlock Text="Search sessions" IsHitTestVisible="False" Margin="9,0,0,0"
                               VerticalAlignment="Center" Foreground="{StaticResource Text.Faint}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding TagFilters}" Margin="0,0,0,4"
                              AutomationProperties.Name="Filter by tag"
                              Visibility="{Binding HasAnySessions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Button.TagChip}" Content="{Binding Label}"
                                    Click="TagChip_Click" AutomationProperties.Name="{Binding Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="2">
                    <ListBox x:Name="SessionsList" ItemsSource="{Binding Rows}"
                             SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource SessionCard}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Saved sessions"
                             MouseDoubleClick="SessionsList_MouseDoubleClick"
                             KeyDown="SessionsList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                               TextTrimming="CharacterEllipsis" />
                                    <ItemsControl ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagPill}"
                                                  Margin="0,4,0,0" Focusable="False"
                                                  Visibility="{Binding HasTags, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding DetailText}" FontSize="12" Margin="0,4,0,0"
                                               Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding ListPlaceholder}" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,32,16,0"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{StaticResource Text.Faint}" FontStyle="Italic"
                               Style="{StaticResource CollapsedWhenEmpty}" />
                </Grid>
            </Grid>

            <!-- Right: the selected session. -->
            <Border Grid.Column="2" Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Border.Default}"
                    BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding SelectedRow.Name}" FontSize="18" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedRow.Tags}" ItemTemplate="{StaticResource TagPill}"
                                      Margin="0,6,0,0" Focusable="False"
                                      Visibility="{Binding SelectedRow.HasTags, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Grid.Row="2" Text="{Binding SelectedRow.DetailText}" Margin="0,6,0,10"
                                   Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" />

                        <DataGrid Grid.Row="3" x:Name="FilesGrid" ItemsSource="{Binding SelectedFiles}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" AutomationProperties.Name="PDFs in this session"
                                  KeyboardNavigation.TabNavigation="Once"
                                  MouseDoubleClick="FilesGrid_MouseDoubleClick" PreviewKeyDown="FilesGrid_PreviewKeyDown">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="PDF" SortMemberPath="FileName" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE8A5;" Style="{StaticResource TextBlock.Glyph}" />
                                                <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="1.3*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="_Open all" Style="{StaticResource Button.Primary}" Margin="0,0,8,0"
                                    ToolTip="Open every PDF in this session (Enter)" Click="OpenAll_Click" />
                            <Button Content="Open selected PDF" Margin="0,0,8,0"
                                    ToolTip="Open just the PDF selected above (or double-click it)" Click="OpenFile_Click" />
                            <Button Content="_Edit…" Margin="0,0,8,0" IsEnabled="{Binding CanEditSelection}"
                                    ToolTip="Rename, retag, or add and remove PDFs" Click="Edit_Click" />
                            <Button Content="_Delete…" IsEnabled="{Binding CanEditSelection}"
                                    ToolTip="Delete this session. Its PDFs are not touched." Click="Delete_Click" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Choose a session to see its PDFs." Foreground="{StaticResource Text.Faint}"
                               FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- What the last action did, then what went wrong with it. -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Status.Success}"
                       TextWrapping="Wrap" Style="{StaticResource CollapsedWhenEmpty}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Status.Error}"
                       TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource CollapsedWhenEmpty}" />
        </StackPanel>

        <Button Grid.Row="3" Content="Close" MinWidth="84" HorizontalAlignment="Right" Margin="0,12,0,0"
                IsCancel="True" />
    </Grid>
</Window>
