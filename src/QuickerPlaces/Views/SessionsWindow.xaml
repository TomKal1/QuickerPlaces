<Window x:Class="QuickerPlaces.Views.SessionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="clr-namespace:QuickerPlaces.Views.Panels"
        Title="Project Sessions"
        Width="940" Height="620" MinWidth="720" MinHeight="460"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!--
        Sessions plan §5. The window around the Sessions panel (configurable
        canvas plan M2), kept while the workspace is built: a title, the
        panel, and Close. Everything the window used to do is in the panel.
    -->
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Project Sessions" Style="{StaticResource TextBlock.WindowTitle}" />
            <TextBlock Text="Save the PDF, Word and Excel files you have open as a tagged session, then reopen them together later."
                       Foreground="{DynamicResource Text.Secondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
            <Control Style="{StaticResource TrimBand}" Margin="-20,14,-20,0" />
        </StackPanel>

        <panels:SessionsPanel x:Name="Panel" Grid.Row="1" />

        <Button Grid.Row="2" Content="Close" MinWidth="84" HorizontalAlignment="Right" Margin="0,12,0,0"
                IsCancel="True" />
    </Grid>
</Window>
