<Window x:Class="QuickerPlaces.Views.PlaceFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="460"
        WindowStartupLocation="CenterOwner"
        d:DesignHeight="240" d:DesignWidth="460">
    <!--
        The combined Add-a-Place dialog (SI §6.1) and the two single-field
        edit dialogs (Rename Alias / Edit Path-URL) share this one Window —
        ConfigureFields() in the code-behind shows/hides the Alias and
        Resource panels per PlaceFormMode. A plain themed Window like
        MessageForm, so it picks up Bg.Glow/Font.Sans/Text.Primary from
        Theme.xaml for free.
    -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="AliasPanel" Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Alias" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="AliasTextBox" />
        </StackPanel>

        <StackPanel x:Name="ResourcePanel" Grid.Row="1" Margin="0,0,0,14">
            <TextBlock x:Name="ResourceLabel" Text="Folder path" FontWeight="SemiBold" Margin="0,0,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ResourceTextBox" Grid.Column="0" />
                <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse..." Margin="8,0,0,0"
                        Click="BrowseButton_Click" />
            </Grid>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="{StaticResource Status.Error}"
                   TextWrapping="Wrap" MaxWidth="412" HorizontalAlignment="Left"
                   Margin="0,0,0,14" Visibility="Collapsed" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Margin="0,0,8,0"
                    IsCancel="True" Click="CancelButton_Click" />
            <Button x:Name="OkButton" Content="OK" Style="{StaticResource Button.Primary}"
                    IsDefault="True" Click="OkButton_Click" />
        </StackPanel>
    </Grid>
</Window>
