<UserControl x:Class="QuickerPlaces.Views.Panels.RecentFilesSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ScopeChoice" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource {x:Static SystemParameters.FocusVisualStyleKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="{DynamicResource Bg.Raised}" BorderBrush="{DynamicResource Border.Strong}"
                                BorderThickness="2" CornerRadius="7" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Indicator" Width="18" Height="18" CornerRadius="9" BorderThickness="2"
                                        BorderBrush="{DynamicResource Border.Strong}" VerticalAlignment="Top" Margin="0,1,10,0">
                                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Highlight}" Visibility="Hidden" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <ContentPresenter RecognizesAccessKey="True" />
                                    <TextBlock x:Name="SelectedLabel" Text="Selected" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource Highlight.Text}" Margin="0,8,0,0" Visibility="Hidden" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Bg.RowHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Highlight.Soft}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Highlight}" />
                                <Setter TargetName="Indicator" Property="BorderBrush" Value="{DynamicResource Highlight}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="SelectedLabel" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Highlight}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
            CornerRadius="8" Padding="14,12" IsEnabled="{Binding RecentFilesAvailable}">
        <StackPanel>
            <CheckBox Content="Record the PDF, Word and Excel files I open" IsChecked="{Binding RecentFilesEnabled}" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource TextBlock.Hint}" Margin="28,4,0,10"
                       Text="Read once a minute from Windows' own Recent Items while QuickerPlaces is running, from the moment you turn this on. It records which file and when — never what's in it — and keeps a year on this computer only. Programs that don't tell Windows about the files they open won't show here." />
            <TextBlock Text="File types" Style="{StaticResource TextBlock.FieldLabel}" Margin="28,2,0,8" />
            <StackPanel Orientation="Horizontal" Margin="28,0,0,16">
                <CheckBox Content="PDF" IsChecked="{Binding TrackPdf}" Margin="0,0,16,0" />
                <CheckBox Content="Word" IsChecked="{Binding TrackWord}" Margin="0,0,16,0" />
                <CheckBox Content="Excel" IsChecked="{Binding TrackExcel}" />
            </StackPanel>
            <TextBlock Text="Where to record" Style="{StaticResource TextBlock.FieldLabel}" Margin="28,0,0,8" />
            <UniformGrid Columns="2" Margin="28,0,0,0">
                <RadioButton Style="{StaticResource ScopeChoice}" Margin="0,0,5,0"
                             IsChecked="{Binding TrackUnderTrackedFolders, Mode=TwoWay}"
                             AutomationProperties.Name="Tracked folders only"
                             AutomationProperties.HelpText="Only files under folders tracked in Recents.">
                    <StackPanel>
                        <TextBlock Text="Tracked folders only" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Only files under folders tracked in Recents." Style="{StaticResource TextBlock.Hint}" Margin="0,4,0,0" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource ScopeChoice}" Margin="5,0,0,0"
                             IsChecked="{Binding TrackEverywhere, Mode=TwoWay}"
                             AutomationProperties.Name="Anywhere"
                             AutomationProperties.HelpText="Files in any folder, including outside your tracked folders.">
                    <StackPanel>
                        <TextBlock Text="Anywhere" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Files in any folder, including outside your tracked folders." Style="{StaticResource TextBlock.Hint}" Margin="0,4,0,0" />
                    </StackPanel>
                </RadioButton>
            </UniformGrid>
        </StackPanel>
    </Border>
</UserControl>
