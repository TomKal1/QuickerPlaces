<UserControl x:Class="QuickerPlaces.Views.Panels.PanelFrame"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <!--
        One panel on the workspace canvas (configurable canvas plan D1, M4):
        its title and Hide above the panel itself. In Arrange mode it also
        shows a handle to drag it by, Move earlier and Move later, a width
        choice, a dashed outline, and an edge to drag for its width. The
        handle and the edge are for the mouse; the buttons and the width
        choice do the same from the keyboard. The workspace view places the
        frame and does the dragging; this only raises what was asked.
    -->
    <Grid>
        <DockPanel Margin="6">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="True">
                <Button x:Name="HideButton" DockPanel.Dock="Right" Style="{StaticResource Button.IconOnlyCompact}"
                        Width="24" Height="24" Click="Hide_Click">
                    <Viewbox Width="10" Height="10">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Close}" />
                    </Viewbox>
                </Button>
                <StackPanel x:Name="ArrangeControls" DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,6,0"
                            Visibility="Collapsed">
                    <Button x:Name="EarlierButton" Style="{StaticResource Button.IconOnlyCompact}" Width="24" Height="24"
                            Click="Earlier_Click">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.ChevronLeft}" />
                    </Button>
                    <Button x:Name="LaterButton" Style="{StaticResource Button.IconOnlyCompact}" Width="24" Height="24" Margin="4,0,6,0"
                            Click="Later_Click">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.ChevronRight}" />
                    </Button>
                    <ComboBox x:Name="WidthChoice" Height="26" MinWidth="104" Padding="8,0,6,0" FontSize="12"
                              SelectionChanged="WidthChoice_SelectionChanged">
                        <ComboBoxItem Content="A third" Tag="4" />
                        <ComboBoxItem Content="Half" Tag="6" />
                        <ComboBoxItem Content="Two thirds" Tag="8" />
                        <ComboBoxItem Content="Full width" Tag="12" />
                    </ComboBox>
                </StackPanel>
                <Thumb x:Name="MoveHandle" DockPanel.Dock="Left" Width="18" Height="24" Margin="0,0,6,0" Cursor="SizeAll"
                       Visibility="Collapsed" Focusable="False"
                       DragStarted="MoveHandle_DragStarted" DragDelta="MoveHandle_DragDelta" DragCompleted="MoveHandle_DragCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent" CornerRadius="4">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Grip}" Stroke="{DynamicResource Text.Secondary}"
                                      StrokeThickness="2.2" HorizontalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                <TextBlock x:Name="TitleText" Style="{StaticResource TextBlock.Caps}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <Border x:Name="ContentHost" />
        </DockPanel>

        <Rectangle x:Name="ArrangeOutline" Margin="1" RadiusX="9" RadiusY="9" StrokeThickness="1.5" StrokeDashArray="4 3"
                   Stroke="{DynamicResource Highlight.Text}" IsHitTestVisible="False" Visibility="Collapsed" />

        <!-- The edge to drag for the width; the width choice is the keyboard's way. -->
        <Thumb x:Name="ResizeHandle" HorizontalAlignment="Right" Width="10" Margin="0,36,-2,12" Cursor="SizeWE"
               Visibility="Collapsed" Focusable="False"
               DragStarted="ResizeHandle_DragStarted" DragDelta="ResizeHandle_DragDelta" DragCompleted="ResizeHandle_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Border Width="4" Height="36" CornerRadius="2" Background="{DynamicResource Highlight.Text}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</UserControl>
