<Window x:Class="QuickerPlaces.Views.RecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="460"
        WindowStartupLocation="CenterOwner"
        Closing="RecoveryDialog_Closing"
        d:DesignHeight="200" d:DesignWidth="460">
    <!--
        The startup recovery prompt (plan 5.4) — a themed sibling of
        MessageForm, not MessageForm itself: MessageFormButtons only offers
        fixed OK/Cancel/Yes/No sets, and "Start with an empty list" must
        never sit where a user could reach it by muscle memory while
        reading "Yes". RecoveryDialog instead takes an ordered list of
        custom-labelled RecoveryOptions and builds its button row from
        them in code-behind — see RecoveryDialog.xaml.cs. Being a plain
        Window, it picks up the app-wide Bg.Glow/Text.Primary/Font.Sans
        style from Theme.xaml automatically, same as MessageForm.
    -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top">
            <Border x:Name="IconBadge" Width="36" Height="36" CornerRadius="18"
                    VerticalAlignment="Top" Margin="0,0,14,0"
                    Background="{StaticResource Status.Warning}">
                <TextBlock Text="!" FontWeight="Bold" FontSize="16"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14"
                       MaxWidth="360" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock x:Name="PathText" Grid.Row="1" TextWrapping="Wrap" FontSize="12"
                   Foreground="{StaticResource Text.Secondary}"
                   Margin="0,12,0,0" />

        <StackPanel x:Name="ButtonPanel" Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,24,0,0" />
    </Grid>
</Window>
