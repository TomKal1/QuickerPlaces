<Window x:Class="QuickerPlaces.Views.SessionEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="820" Height="600" MinWidth="620" MinHeight="460"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!--
        Sessions plan §5, D9: the review step. Name and tags at the top; the
        PDFs found or added, each with a tick, in the middle; what the scan
        found under the list. Only ticked PDFs are saved, and nothing is
        saved until Save. DataContext is a SessionEditorViewModel; the
        code-behind runs the scan off the UI thread and the file picker.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="CollapsedWhenEmpty" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Button.TagSuggestion" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
            <Setter Property="Background" Value="{StaticResource Bg.Elevated}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border.Strong}" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="11">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Label Content="Session _name" Target="{Binding ElementName=NameBox}" Padding="0" Margin="0,0,0,6"
                       FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" />
                <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="100" AutomationProperties.Name="Session name" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="_Tags (separate with commas)" Target="{Binding ElementName=TagsBox}" Padding="0" Margin="0,0,0,6"
                       FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" />
                <TextBox x:Name="TagsBox" Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Tags" ToolTip="For example: Tower B, markups, RFI 12" />
            </StackPanel>
        </Grid>

        <!-- Tags other sessions use, to add with a click. -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8"
                   Visibility="{Binding HasTagSuggestions, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock DockPanel.Dock="Left" Text="Your tags:" Foreground="{StaticResource Text.Secondary}"
                       Margin="0,3,8,0" VerticalAlignment="Top" />
            <ItemsControl ItemsSource="{Binding TagSuggestions}" AutomationProperties.Name="Your tags">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Button.TagSuggestion}" Content="{Binding}" Click="TagSuggestion_Click"
                                ToolTip="Add this tag" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <DockPanel Grid.Row="2" Margin="0,4,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ScanButton" Content="Find open PDFs" Margin="0,0,8,0" Click="Scan_Click"
                        ToolTip="Look again for PDFs open now; files already listed keep their ticks" />
                <Button Content="_Add PDFs…" Click="AddFiles_Click" ToolTip="Choose PDFs to add by hand" />
            </StackPanel>
            <TextBlock Text="PDFs" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding IncludedText}" Foreground="{StaticResource Text.Secondary}"
                       VerticalAlignment="Center" Margin="10,0,0,0" />
        </DockPanel>

        <Grid Grid.Row="3">
            <DataGrid x:Name="FilesGrid" ItemsSource="{Binding Files}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      AutomationProperties.Name="PDFs to save" KeyboardNavigation.TabNavigation="Once"
                      PreviewKeyDown="FilesGrid_PreviewKeyDown">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Save" Width="52" SortMemberPath="IsIncluded">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"
                                          AutomationProperties.Name="{Binding FileName}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="PDF" SortMemberPath="FileName" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="1.3*" />
                    <DataGridTextColumn Header="Why it's listed" Binding="{Binding Reason}" Width="180" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Looking for open PDFs…" IsHitTestVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource Text.Secondary}" FontStyle="Italic"
                       Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Tick all" Margin="0,0,8,0" Click="TickAll_Click" />
                <Button Content="Untick all" Margin="0,0,8,0" Click="UntickAll_Click" />
                <Button Content="_Remove from list" Click="Remove_Click"
                        ToolTip="Take the selected PDFs out of this list (the files are not touched)" />
            </StackPanel>
            <TextBlock Text="Space ticks the selected rows." Foreground="{StaticResource Text.Faint}"
                       VerticalAlignment="Center" />
        </DockPanel>

        <StackPanel Grid.Row="5" Margin="0,10,0,0">
            <TextBlock Text="{Binding ScanSummary}" Foreground="{StaticResource Text.Secondary}"
                       TextWrapping="Wrap" Style="{StaticResource CollapsedWhenEmpty}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Status.Error}"
                       TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource CollapsedWhenEmpty}" />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" MinWidth="84" Margin="0,0,8,0" IsCancel="True" />
            <Button x:Name="SaveButton" Content="Save" MinWidth="84" Style="{StaticResource Button.Primary}"
                    IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
