<Window x:Class="QuickerPlaces.Views.ShareSessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="820" Height="540" MinWidth="620" MinHeight="400"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!--
        Session sharing plan §5: the session's files, where each lives and a
        tick for whether it goes in the shared file; what the recipient can
        and can't reach; what the file reveals. Nothing is written until
        Save. DataContext is a ShareSessionViewModel; the code-behind shows
        the Save As picker and writes the file.
    -->
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="14">
            Save this session as a file to send to another QuickerPlaces user. When they open it, QuickerPlaces finds each file
            in their own synced copy of the library, on the network, or at the same path.
        </TextBlock>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Tick all" Style="{StaticResource Button.Compact}" Margin="0,0,8,0" Click="TickAll_Click" />
                <Button Content="Untick all" Style="{StaticResource Button.Compact}" Click="UntickAll_Click" />
            </StackPanel>
            <TextBlock Text="FILES" Style="{StaticResource TextBlock.Caps}" />
            <TextBlock Text="{Binding IncludedText}" Foreground="{DynamicResource Text.Secondary}"
                       VerticalAlignment="Center" Margin="10,0,0,0" />
        </DockPanel>

        <DataGrid Grid.Row="2" x:Name="FilesGrid" ItemsSource="{Binding Files}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended"
                  AutomationProperties.Name="Files to share" KeyboardNavigation.TabNavigation="Once"
                  PreviewKeyDown="FilesGrid_PreviewKeyDown">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="SHARE" Width="64" SortMemberPath="IsIncluded">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"
                                      AutomationProperties.Name="{Binding FileName}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="FILE" SortMemberPath="FileName" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource Icon.Row}" Data="{StaticResource Icon.Document}" />
                                <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="FOLDER" Binding="{Binding Folder}" Width="1.3*" ElementStyle="{StaticResource Cell.Path}" />
                <DataGridTemplateColumn Header="WHERE IT LIVES" SortMemberPath="LocationText" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding LocationText}" ToolTip="{Binding Detail}" Style="{StaticResource Cell.Secondary}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding Advice}" Foreground="{DynamicResource Signal}" TextWrapping="Wrap"
                   Margin="0,10,0,0" Style="{StaticResource CollapsedWhenEmpty}" />

        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock x:Name="PrivacyText" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}"
                       TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource CollapsedWhenEmpty}" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" MinWidth="84" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="_Save shared file…" MinWidth="84" Style="{StaticResource Button.Primary}"
                    IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
