<Window x:Class="QuickerPlaces.Views.FolderTrackingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder Activity" Width="700" MinWidth="560" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="TargetCard" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="{DynamicResource Bg.Raised}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Highlight.Soft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Highlight}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.AllFolders, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Bg.Raised}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Folder Activity" Style="{StaticResource TextBlock.WindowTitle}" />
            <TextBlock Text="Choose which folders you visit in File Explorer to record." Margin="0,3,0,0"
                       Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" />
            <Control Style="{StaticResource TrimBand}" Margin="-20,14,-20,14" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="{DynamicResource Bg.Raised}" BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel>
                        <CheckBox x:Name="AllFoldersToggle" Content="Track all folders I visit" FontWeight="SemiBold"
                                  IsChecked="{Binding AllFolders, Mode=TwoWay}" IsEnabled="{Binding IsAvailable}"
                                  AutomationProperties.HelpText="Overrides your target folders while on. Turning it off restores your target selections." />
                        <TextBlock Text="Record visits anywhere in File Explorer. Turn this off to use your selected target folders."
                                   Style="{StaticResource TextBlock.Hint}" Margin="24,6,0,0" />
                    </StackPanel>
                </Border>
                <DockPanel Margin="0,16,0,10" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Pick folders…" Click="PickFolders_Click"
                            IsEnabled="{Binding CanEditTargets}" Style="{StaticResource Button.Compact}" Margin="12,0,0,0" />
                    <TextBlock Text="Target folders" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="All folders is on. Your target selections are kept; turn it off to edit or use them."
                           Style="{StaticResource TextBlock.Hint}" Margin="0,0,0,10"
                           Visibility="{Binding AllFolders, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <StackPanel x:Name="TargetArea" IsEnabled="{Binding CanEditTargets}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AllFolders}" Value="True">
                                    <Setter Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ItemsControl x:Name="TargetCards" ItemsSource="{Binding Targets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TargetCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled, Mode=TwoWay}" FontWeight="SemiBold"
                                                      AutomationProperties.Name="{Binding Path}" />
                                            <TextBlock Text="{Binding Path}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                                       Foreground="{DynamicResource Text.Secondary}" Margin="24,5,12,0" TextWrapping="Wrap" />
                                            <TextBlock FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="24,5,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Status}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.AllFolders, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                <Setter Property="Text" Value="Selection kept for target mode" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Remove" Click="RemoveFolder_Click" VerticalAlignment="Center"
                                                Style="{StaticResource Button.Compact}" Margin="12,0,0,0"
                                                AutomationProperties.HelpText="Removes this target when you save. Recorded history is kept." />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No target folders yet. Pick folders to track, or turn on All folders."
                               Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTargets}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Border Background="{DynamicResource Highlight.Soft}" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                    <TextBlock Text="{Binding SelectionSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="Uncheck a target to pause it, or remove it from this list. Recorded history is kept. Save applies your changes and closes this panel."
                           Style="{StaticResource TextBlock.Hint}" Margin="0,12,0,0" />
                <TextBlock Text="Only folders you visit are recorded; this does not scan your directories. By default, a visit counts after 5 seconds, and time stops after 5 minutes idle. Adjust these thresholds from a folder’s chip in Recents."
                           Style="{StaticResource TextBlock.Hint}" Margin="0,8,0,0" />
                <TextBlock Text="Recent Files has its own setting for PDF, Word and Excel files. These folder settings are saved separately from the main Settings window."
                           Style="{StaticResource TextBlock.Hint}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource Signal}" Style="{StaticResource CollapsedWhenEmpty}"
                           TextWrapping="Wrap" Margin="0,10,0,0" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}" Style="{StaticResource CollapsedWhenEmpty}"
                           TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SaveStatus}" TextWrapping="Wrap" Margin="0,0,14,0"
                       VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Signal}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Close" MinWidth="84" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="Save" MinWidth="84" Style="{StaticResource Button.Primary}" IsDefault="True"
                        IsEnabled="{Binding CanSave}" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
