<Window x:Class="QuickerPlaces.Views.RecentlyDeletedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:QuickerPlaces.ViewModels"
        mc:Ignorable="d"
        Title="Recently Deleted"
        Height="480" Width="780"
        MinHeight="320" MinWidth="660"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        d:DesignHeight="480" d:DesignWidth="780">
    <!--
        Roadmap §4.9, plan 5.5. Laid out like ExportDialog/ImportDialog: an
        intro line, the grid, an error line, then the buttons. DataContext
        is a RecentlyDeletedViewModel, which decides everything shown here
        (D21); the code-behind only passes the grid's selection in, asks the
        two irreversible questions, and runs the restore-conflict dialog.

        No row action is bound to Enter or Delete, so nothing irreversible
        is one keystroke away: the grid is read-only with row deletion off,
        and Close is both the default and the cancel button. Tab leaves the
        grid in one step (TabNavigation="Once") rather than walking every
        cell, so the buttons are one Tab away from the selection.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Places you removed stay here for 7 days, then are deleted for good. Restoring one puts it back where it was, favourite included."
                   FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <DataGrid x:Name="ItemsGrid"
                      ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Extended"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      AutomationProperties.Name="Places in Recently Deleted"
                      KeyboardNavigation.TabNavigation="Once"
                      SelectionChanged="ItemsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <!-- Type glyph beside the alias, as in the main grid; SortMemberPath keeps header-click sorting by Alias. -->
                    <DataGridTemplateColumn Header="Alias" SortMemberPath="Alias" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TypeGlyph}" Style="{StaticResource TextBlock.Glyph}" />
                                    <TextBlock Text="{Binding Alias}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="70" />
                    <DataGridTextColumn Header="Path / URL" Binding="{Binding Resource}" Width="2*" />
                    <!-- Rows arrive newest deletion first; SortDirection only shows that order's arrow. Both date columns sort on the UTC instant, not the text. -->
                    <DataGridTextColumn Header="Deleted" Binding="{Binding DeletedText}" SortMemberPath="DeletedAt"
                                        SortDirection="Descending" Width="140" />
                    <DataGridTextColumn Header="Days remaining" Binding="{Binding DaysRemainingText}" SortMemberPath="DeletedAt" Width="120">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="ToolTip" Value="{Binding ExpiryToolTip}" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty state, over the grid as in the main window. -->
            <TextBlock Text="{x:Static vm:RecentlyDeletedViewModel.EmptyMessage}"
                       IsHitTestVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,32,16,0"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{StaticResource Text.Faint}" FontStyle="Italic"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <!-- The dialog's own error line (plan 5.5): a failed save, shown here rather than only behind the modal. -->
        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="{StaticResource Status.Error}"
                   TextWrapping="Wrap" Margin="0,12,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="_Restore selected" Style="{StaticResource Button.Primary}" Margin="0,0,8,0"
                        IsEnabled="{Binding CanActOnSelection}"
                        ToolTip="Put the selected places back in the list"
                        Click="RestoreButton_Click" />
                <Button Content="_Delete selected permanently" Margin="0,0,8,0"
                        IsEnabled="{Binding CanActOnSelection}"
                        ToolTip="Delete the selected places for good. Asks first; can't be undone."
                        Click="DeleteButton_Click" />
                <Button Content="_Empty Recently Deleted"
                        IsEnabled="{Binding CanEmpty}"
                        ToolTip="Delete every place here for good. Asks first; can't be undone."
                        Click="EmptyButton_Click" />
            </StackPanel>

            <!-- IsCancel closes a modal window by itself, on click, Esc, and (as the default button) Enter. -->
            <Button Grid.Column="1" x:Name="CloseButton" Content="Close" MinWidth="84"
                    IsDefault="True" IsCancel="True" />
        </Grid>
    </Grid>
</Window>
